// Both readers see items, groups and holds. Reading a link or a role requires the restricted capability.
.decl may_read(role: symbol, kind: symbol, element: symbol)
may_read(r, "item", i) :- role__capability(r, "read"), item(i).
may_read(r, "group", g) :- role__capability(r, "read"), group(g).
may_read(r, "hold", h) :- role__capability(r, "read"), hold(h).
may_read(r, "link", l) :- role__capability(r, "read_restricted"), link(l).
may_read(r, "role", x) :- role__capability(r, "read_restricted"), role(x).

.decl may_read_full(role: symbol, kind: symbol)
may_read_full(r, "item") :- role__capability(r, "read").
may_read_full(r, "group") :- role__capability(r, "read").
may_read_full(r, "hold") :- role__capability(r, "read").
may_read_full(r, "link") :- role__capability(r, "read_restricted").
may_read_full(r, "role") :- role__capability(r, "read_restricted").
