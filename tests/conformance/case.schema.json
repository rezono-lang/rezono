{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable conformance case",
  "type": "object",
  "required": ["id", "source", "status", "input", "expect"],
  "additionalProperties": false,
  "$defs": {
    "snapshotKey": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "snapshotState": {"enum": ["known", "not_applicable", "unknown", "invalid"]},
    "snapshotRow": {
      "type": "object",
      "required": ["key", "values"],
      "additionalProperties": false,
      "properties": {
        "key": {"$ref": "#/$defs/snapshotKey"},
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["state"],
                "additionalProperties": false,
                "properties": {
                  "state": {"$ref": "#/$defs/snapshotState"},
                  "reason": {"type": "string"},
                  "value": {"type": "string"}
                }
              },
              {
                "type": "object",
                "required": ["state", "currency", "minor_units"],
                "additionalProperties": false,
                "properties": {
                  "state": {"$ref": "#/$defs/snapshotState"},
                  "minor_units": {"type": "string"},
                  "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string"},
    "status": {"const": "settled"},
    "input": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "items": {"type": "object"}},
        "select": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "language": {"type": "string", "pattern": "\\S"},
        "snapshot": {
          "type": "object",
          "required": ["key", "slot", "rejected"],
          "additionalProperties": false,
          "properties": {
            "key": {"$ref": "#/$defs/snapshotKey"},
            "slot": {"type": "string", "minLength": 1},
            "rejected": {"$ref": "#/$defs/snapshotRow"}
          }
        },
        "rules": {
          "type": "object",
          "required": ["output", "clauses"],
          "additionalProperties": false,
          "properties": {
            "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"},
            "clauses": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "required": ["value", "state", "reason", "witness"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "state": {"enum": ["known", "not_applicable", "unknown", "invalid"]},
        "reason": {"type": ["string", "null"]},
        "witness": {"type": ["object", "array", "null"]},
        "refusal": {"type": "string", "pattern": "\\S"}
      }
    },
    "unsupported": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["compiler", "checker", "feldera", "language"]},
      "additionalProperties": {"type": "string", "pattern": "\\S"}
    }
  },
  "if": {"properties": {"input": {"required": ["snapshot"]}}},
  "then": {
    "properties": {
      "input": {
        "properties": {"rows": {"minItems": 1, "items": {"$ref": "#/$defs/snapshotRow"}}},
        "not": {"anyOf": [{"required": ["language"]}, {"required": ["rules"]}, {"required": ["select"]}]}
      },
      "expect": {"required": ["refusal"]}
    }
  },
  "else": {"properties": {"expect": {"not": {"required": ["refusal"]}}}}
}
