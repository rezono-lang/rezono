{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable conformance case",
  "type": "object",
  "required": ["id", "source", "status", "input", "expect"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string"},
    "status": {"const": "settled"},
    "input": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {"type": "array", "items": {"type": "object"}},
        "role_worlds": {
          "type": "object",
          "required": ["output", "clauses", "worlds"],
          "additionalProperties": false,
          "properties": {
            "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"},
            "clauses": {"type": "string", "pattern": "\\S"},
            "worlds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": ["name", "added_rows"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"},
                  "added_rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["kind", "id"],
                      "properties": {
                        "kind": {"type": "string", "minLength": 1},
                        "id": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "select": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "language": {"type": "string", "pattern": "\\S"},
        "rules": {
          "type": "object",
          "required": ["output", "clauses"],
          "additionalProperties": false,
          "properties": {
            "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"},
            "clauses": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "required": ["value", "state", "reason", "witness"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "state": {"enum": ["known", "not_applicable", "unknown", "invalid"]},
        "reason": {"type": ["string", "null"]},
        "witness": {"type": ["object", "array", "null"]}
      }
    },
    "unsupported": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["compiler", "checker", "feldera", "language"]},
      "additionalProperties": {"type": "string", "pattern": "\\S"}
    }
  }
}
