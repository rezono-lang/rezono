{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication conformance case",
  "description": "A public conformance case. Payloads and schema patches may intentionally violate the publication format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "status", "schema", "form", "expect"],
  "properties": {
    "id": {"$ref": "#/$defs/caseId"},
    "class": {
      "enum": ["valid", "invalid", "change", "hash", "context", "admission", "oracle", "round-trip", "answer", "subscribe"]
    },
    "status": {"enum": ["settled", "pending", "open"]},
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {"const": "fixture.schema.json"},
        "merge": {"type": "object"}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge"],
      "properties": {"merge": {"type": "object"}}
    },
    "form": {
      "enum": ["schema", "schema-text", "row", "rows", "collection", "datasets", "json-text", "jsonl",
               "jsonld", "arrow-field", "parquet", "parquet-metadata", "delta", "answer", "request", "events"]
    },
    "input": {},
    "expect": {"$ref": "#/$defs/expectation"},
    "note": {"type": "string"},
    "sources": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"form": {"const": "schema"}}},
      "then": {"properties": {"input": {"type": "string"}}},
      "else": {"required": ["input"]}
    },
    {
      "if": {"properties": {"form": {"enum": ["schema-text", "jsonl", "parquet", "answer", "request", "events"]}}},
      "then": {"properties": {"input": {"type": "string"}}}
    },
    {
      "if": {"properties": {"form": {"enum": ["row", "jsonld", "arrow-field", "parquet-metadata", "delta"]}}},
      "then": {"properties": {"input": {"type": "object"}}}
    },
    {
      "if": {"properties": {"form": {"const": "collection"}}},
      "then": {"properties": {"input": {"type": ["object", "string"]}}}
    },
    {
      "if": {"properties": {"form": {"const": "rows"}}},
      "then": {"properties": {"input": {"type": "array", "items": {"type": "object"}}}}
    },
    {
      "if": {"properties": {"form": {"const": "datasets"}}},
      "then": {"properties": {"input": {"type": "array", "items": {"type": "array", "items": {"type": "object"}}}}}
    },
    {
      "if": {"properties": {"form": {"const": "json-text"}}},
      "then": {"properties": {"input": {"$ref": "#/$defs/textList"}}}
    }
  ],
  "$defs": {
    "caseId": {"type": "string", "pattern": "^[A-Z][0-9]{2}(?![\\s\\S])"},
    "schemaId": {"type": "string", "pattern": "^s-[0-9a-f]{64}(?![\\s\\S])"},
    "datasetId": {"type": "string", "pattern": "^d-[0-9a-f]{64}(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "textList": {"type": "array", "items": {"type": "string"}},
    "expectation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "accept": {"type": "boolean"},
        "error": {"type": "string"},
        "schema_id": {"$ref": "#/$defs/schemaId"},
        "schema_id_differs_without": {"type": "string"},
        "dataset_hash": {"$ref": "#/$defs/datasetId"},
        "annotation_hash": {"$ref": "#/$defs/sha256"},
        "side_tables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "without_why": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_hash", "annotation_hash"],
          "properties": {
            "dataset_hash": {"$ref": "#/$defs/datasetId"},
            "annotation_hash": {"$ref": "#/$defs/sha256"}
          }
        },
        "change_class": {"enum": ["patch", "minor", "major", "invalid_successor"]},
        "read_old_rows": {"type": "object", "additionalProperties": {"type": "object"}},
        "same_rows_as": {"$ref": "#/$defs/caseId"},
        "same_definition_hash": {"type": "boolean"},
        "same_dataset_hash": {"type": "boolean"},
        "versions": {"type": "integer", "minimum": 0},
        "hash_keys": {"type": "array", "items": {"$ref": "#/$defs/textList"}},
        "payload": {"type": "object"},
        "arrow_ref_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pack", "schema", "manifest", "dataset"],
          "properties": {
            "kind": {"type": "string"},
            "pack": {"type": "string"},
            "schema": {"$ref": "#/$defs/schemaId"},
            "manifest": {"type": "string", "pattern": "^m-[0-9]+(?![\\s\\S])"},
            "dataset": {"$ref": "#/$defs/datasetId"}
          }
        },
        "storage_values_as_written": {"type": "boolean"},
        "readers": {"$ref": "#/$defs/textList"},
        "expanded": {"type": "object", "additionalProperties": {"type": "string"}},
        "iris": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "iri"],
            "properties": {
              "kind": {"type": "string"},
              "id": {"type": "string"},
              "iri": {"type": "string"}
            }
          }
        },
        "same_triples_as": {"type": "string"},
        "same_validation_as": {"type": "string"},
        "refused": {"type": "boolean"},
        "kinds": {"$ref": "#/$defs/textList"},
        "answer_slots": {"$ref": "#/$defs/textList"},
        "undecided_slots": {"$ref": "#/$defs/textList"},
        "schema_member_is_output_schema_id": {"type": "boolean"},
        "same_dataset_hash_in_both_worlds": {"type": "boolean"},
        "events": {"type": "integer", "minimum": 0},
        "event_for": {"type": "string"},
        "event_pins": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
