.decl build_utc_day(tick: number, unix_day: number)
.decl build_claimed_policy_date(run: symbol, tick: number, reference: symbol, day: number)
.decl build_policy_date_conflict(run: symbol, tick: number)
.decl build_policy_date_at_cut(run: symbol, reference: symbol)

// Integer division truncates toward zero. Recover floor division without subtracting
// from the original tick, which can be the smallest signed integer.
build_utc_day(tick, unix_day) :- build_run__observed_at(_, tick),
    unix_day = tick / 86400, start = unix_day * 86400, tick >= start.
build_utc_day(tick, unix_day) :- build_run__observed_at(_, tick),
    quotient = tick / 86400, start = quotient * 86400, tick < start, unix_day = quotient - 1.

build_claimed_policy_date(run, tick, reference, day) :- build_verified_cut(run),
    build_policy_date__run(binding, run), build_policy_date__reference(binding, reference),
    build_policy_date__observed_at(binding, tick), build_run__observed_at(run, tick),
    reference_date__date(reference, calendar_date), day = @days(calendar_date, "1970-01-01").

build_policy_date_conflict(run, tick) :- build_claimed_policy_date(run, tick, _, first),
    build_claimed_policy_date(run, tick, _, second), first != second.

build_policy_date_at_cut(run, reference) :- build_claimed_policy_date(run, tick, reference, claimed),
    build_utc_day(tick, unix_day), claimed = unix_day, !build_policy_date_conflict(run, tick).
