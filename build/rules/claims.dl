.decl build_claim_at_cut(run: symbol, claim: symbol, generation: symbol, tick: number)
.decl build_claim_push(claim: symbol, after: symbol, at: number)
.decl build_claim_superseded_push(claim: symbol, at: number)
.decl build_claim_latest_push(claim: symbol, after: symbol, at: number)
.decl build_claim_push_tie(claim: symbol)
.decl build_claim_lease_start(claim: symbol, start: number)
.decl build_claim_has_lease_start(claim: symbol)
.decl build_claim_duration(run: symbol, seconds: number, decision: symbol)
.decl build_claim_duration_conflict(run: symbol)
.decl build_claim_lease_policy(run: symbol, seconds: number, decision: symbol)
.decl build_claim_has_lease_policy(run: symbol)
.decl build_claim_lease_ended(run: symbol, claim: symbol)
.decl build_claim_pull_open(run: symbol, claim: symbol)
.decl build_claim_pull_none(run: symbol, claim: symbol)
.decl build_claim_release_plan(run: symbol, claim: symbol, generation: symbol, reason: symbol)
.decl build_claim_held(run: symbol, claim: symbol, reason: symbol)

// A claim is evaluated only at the verified cut that listed it.
build_claim_at_cut(run, claim, generation, tick) :- build_verified_cut(run), build_run__observed_at(run, tick),
    build_claim__run(claim, run), build_claim__observed_at(claim, tick), build_claim__generation(claim, generation),
    build_claim__source(claim, source), source != "".

// Only the latest push starts a lease. Equally recent pushes of different commits leave it undecided.
build_claim_push(claim, after, at) :- build_claim_activity__claim(push, claim), build_claim_activity__after(push, after),
    build_claim_activity__pushed_at(push, at), build_claim_activity__source(push, source), source != "".
build_claim_superseded_push(claim, at) :- build_claim_push(claim, _, at), build_claim_push(claim, _, later), later > at.
build_claim_latest_push(claim, after, at) :- build_claim_push(claim, after, at), !build_claim_superseded_push(claim, at).
build_claim_push_tie(claim) :- build_claim_latest_push(claim, a, _), build_claim_latest_push(claim, b, _), a != b.
build_claim_lease_start(claim, at) :- build_claim_at_cut(_, claim, generation, _),
    build_claim_latest_push(claim, generation, at), !build_claim_push_tie(claim).
build_claim_has_lease_start(claim) :- build_claim_lease_start(claim, _).

// Exactly one lease duration must be in force on the policy date of the cut.
build_claim_duration(run, seconds, decision) :- build_policy_date_at_cut(run, date),
    build_claim_lease__decision(lease, decision), build_claim_lease__seconds(lease, seconds), in_force_on(decision, date).
build_claim_duration_conflict(run) :- build_claim_duration(run, a, _), build_claim_duration(run, b, _), a != b.
build_claim_lease_policy(run, seconds, decision) :- build_claim_duration(run, seconds, decision),
    !build_claim_duration_conflict(run).
build_claim_has_lease_policy(run) :- build_claim_lease_policy(run, _, _).

// The model's guard now >= leaseUntil.
build_claim_lease_ended(run, claim) :- build_claim_at_cut(run, claim, _, tick), build_claim_lease_start(claim, start),
    build_claim_lease_policy(run, seconds, _), until = start + seconds, until <= tick.

// An open reading holds the claim. A none reading counts only with the receipt of its complete read,
// in this run at this cut, as the queue reading does.
build_claim_pull_open(run, claim) :- build_claim_at_cut(run, claim, _, tick),
    build_claim_pull_reading__claim(reading, claim), build_claim_pull_reading__observed_at(reading, tick),
    build_claim_pull_reading__state(reading, "open").
build_claim_pull_none(run, claim) :- build_claim_at_cut(run, claim, _, tick),
    build_claim_pull_reading__claim(reading, claim), build_claim_pull_reading__observed_at(reading, tick),
    build_claim_pull_reading__state(reading, "none"), build_claim_pull_reading__source(reading, source), source != "",
    build_claim_pull_reading__receipt(reading, receipt), loop_sweep_receipt__run(receipt, run),
    loop_sweep_receipt__event_time(receipt, tick).

build_claim_release_plan(run, claim, generation, "lease-ended") :- build_claim_at_cut(run, claim, generation, _),
    build_claim_lease_ended(run, claim), build_claim_pull_none(run, claim), !build_claim_pull_open(run, claim).

build_claim_held(run, claim, "lease-active") :- build_claim_at_cut(run, claim, _, _),
    build_claim_has_lease_start(claim), build_claim_has_lease_policy(run), !build_claim_lease_ended(run, claim).
build_claim_held(run, claim, "lease-unknown") :- build_claim_at_cut(run, claim, _, _), !build_claim_has_lease_start(claim).
build_claim_held(run, claim, "lease-policy-unknown") :- build_claim_at_cut(run, claim, _, _),
    !build_claim_has_lease_policy(run).
build_claim_held(run, claim, "pull-request-open") :- build_claim_pull_open(run, claim).
build_claim_held(run, claim, "pull-request-unknown") :- build_claim_at_cut(run, claim, _, _),
    !build_claim_pull_open(run, claim), !build_claim_pull_none(run, claim).
