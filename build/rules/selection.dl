.decl build_verified_cut(run: symbol)
.decl build_full_selection(run: symbol, reason: symbol)
.decl build_manifest_revision(manifest: symbol, run: symbol)
.decl build_valid_dependency(edge: symbol, run: symbol, dependency: symbol, consumer: symbol)
.decl build_path_read(reader: symbol, run: symbol, path: symbol, component: symbol, kind: symbol)
.decl build_affected(run: symbol, component: symbol, path: symbol)
.decl build_selected_job(run: symbol, component: symbol, reason: symbol)

build_verified_cut(run) :- build_run__receipt(run, receipt), build_run__observed_at(run, tick),
    loop_sweep_receipt__run(receipt, run), loop_sweep_receipt__event_time(receipt, tick),
    build_run__base_sha(run, base), build_run__head_sha(run, head), build_run__engine_sha(run, engine).

build_full_selection(run, "missing-observation-receipt") :- build_run(run), !build_verified_cut(run).
build_full_selection(run, "unsupported-event-policy") :- build_run__event(run, "merge_group").
build_full_selection(run, path) :- build_path__run(path, run), build_path__coverage(path, "unknown").

// The collector can observe either diff endpoint; both manifest graphs contribute edges.
build_manifest_revision(manifest, run) :- build_manifest__component(manifest, c), build_component__run(c, run),
    build_manifest__revision(manifest, revision), build_run__base_sha(run, revision).
build_manifest_revision(manifest, run) :- build_manifest__component(manifest, c), build_component__run(c, run),
    build_manifest__revision(manifest, revision), build_run__head_sha(run, revision).

build_valid_dependency(edge, run, dependency, consumer) :-
    build_dependency__dependency(edge, dependency), build_dependency__consumer(edge, consumer),
    build_component__run(dependency, run), build_component__run(consumer, run),
    build_dependency__kind(edge, "manifest"), build_dependency__manifest(edge, manifest),
    build_manifest__component(manifest, consumer), build_manifest_revision(manifest, run),
    build_manifest__path(manifest, path), build_manifest__blob(manifest, blob),
    build_dependency__source(edge, source), source != "".
build_valid_dependency(edge, run, dependency, consumer) :-
    build_dependency__dependency(edge, dependency), build_dependency__consumer(edge, consumer),
    build_component__run(dependency, run), build_component__run(consumer, run),
    build_dependency__kind(edge, "file_reader"), build_dependency__source(edge, source), source != "".

build_full_selection(run, edge) :- build_dependency__dependency(edge, dependency),
    build_dependency__consumer(edge, consumer), build_component__run(consumer, run),
    !build_valid_dependency(edge, run, dependency, consumer).

build_path_read(reader, run, path, component, kind) :- build_path__run(path, run), build_path__coverage(path, "mapped"),
    build_path_reader__path(reader, path), build_path_reader__component(reader, component),
    build_component__run(component, run), build_path_reader__kind(reader, kind),
    build_path_reader__source(reader, source), source != "".

build_full_selection(run, reader) :- build_path_reader__path(reader, path), build_path__run(path, run),
    build_path__coverage(path, "mapped"), build_path_reader__component(reader, component),
    build_path_reader__kind(reader, kind), !build_path_read(reader, run, path, component, kind).

build_affected(run, component, path) :- build_path_read(reader, run, path, component, "transitive").
build_affected(run, consumer, path) :- build_affected(run, dependency, path),
    build_valid_dependency(edge, run, dependency, consumer).

// Coverage of the build scope comes only from an admitted receipt (decisions/scoped-completeness.md section 3).
// Its member keys carry a tag in part 0 and the bound values after it (decisions/admission-transport.md
// section 6): ["changed-path", path], ["path-readers", path, kind], ["path-reader", path, kind, reader],
// ["manifest", revision, path], ["manifest-dependencies", revision, path],
// ["manifest-dependency", revision, path, folder], ["file-dependencies"], ["file-dependency", dependency, consumer],
// ["test-file", path] and ["suite", folder]. A dependency edge names the folders of its components. No run is
// part of a key: the protected build job pins one build-selection context per run, so a second admitted build
// receipt leaves the selection without coverage. The receipt the run record names only selects among admitted
// receipts.
.decl verified_receipt(receipt: symbol, source: symbol, scope: symbol, cut: symbol, inventory: symbol, content: symbol)
.decl verified_member(receipt: symbol, member: symbol, part: number, value: symbol)
.decl complete(source: symbol, scope: symbol, cut: symbol, receipt: symbol)
.decl build_receipt(receipt: symbol)
.decl build_second_receipt(receipt: symbol)
.decl build_covered(run: symbol, receipt: symbol)
.decl build_selection_covered(run: symbol)
.decl build_mapped_reader(receipt: symbol, path: symbol)
.decl build_readerless_path(run: symbol, path: symbol, receipt: symbol)
.decl build_path_accounted(run: symbol, path: symbol)
.decl build_recorded_member(run: symbol, member: symbol)
.decl build_known_folder(run: symbol, folder: symbol)
.decl build_changed_member(receipt: symbol, path: symbol)
.decl build_reader_member(receipt: symbol, path: symbol, kind: symbol, folder: symbol)
.decl build_manifest_dependency_member(receipt: symbol, revision: symbol, path: symbol, folder: symbol)
.decl build_file_dependency_member(receipt: symbol, dependency: symbol, consumer: symbol)

complete(source, scope, cut, receipt) :- verified_receipt(receipt, source, scope, cut, inventory, content).

build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "changed-path").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "path-readers").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "path-reader").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "manifest").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "manifest-dependencies").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "manifest-dependency").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "file-dependencies").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "file-dependency").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "test-file").
build_receipt(receipt) :- complete(source, scope, cut, receipt), verified_member(receipt, m, 0, "suite").
build_second_receipt(receipt) :- build_receipt(receipt), build_receipt(other), receipt != other.

build_covered(run, receipt) :- build_verified_cut(run), build_run__receipt(run, receipt), build_receipt(receipt),
    !build_second_receipt(receipt).
build_selection_covered(run) :- build_covered(run, receipt).
build_full_selection(run, "missing-selection-receipt") :- build_verified_cut(run), !build_selection_covered(run).

// A path is readerless only when the receipt lists both of its mappings and no reader edge for it.
build_mapped_reader(receipt, path) :- verified_member(receipt, m, 0, "path-reader"), verified_member(receipt, m, 1, path).
build_readerless_path(run, path, receipt) :- build_covered(run, receipt), complete(source, scope, cut, receipt),
    verified_member(receipt, changed, 0, "changed-path"), verified_member(receipt, changed, 1, path),
    verified_member(receipt, direct, 0, "path-readers"), verified_member(receipt, direct, 1, path),
    verified_member(receipt, direct, 2, "direct"),
    verified_member(receipt, transitive, 0, "path-readers"), verified_member(receipt, transitive, 1, path),
    verified_member(receipt, transitive, 2, "transitive"),
    !build_mapped_reader(receipt, path).

// Each admitted member of the build scope needs its matching record; otherwise the selection is full.
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "changed-path"),
    verified_member(receipt, m, 1, path), build_path__path(change, path), build_path__run(change, run).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "path-readers"),
    verified_member(receipt, m, 1, path), build_path__path(change, path), build_path__run(change, run).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "path-reader"),
    verified_member(receipt, m, 1, path), verified_member(receipt, m, 2, kind), verified_member(receipt, m, 3, folder),
    build_path__path(change, path), build_path_read(reader, run, change, component, kind),
    build_component__folder(component, folder).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest"),
    verified_member(receipt, m, 1, revision), verified_member(receipt, m, 2, path),
    build_manifest__revision(manifest, revision), build_manifest__path(manifest, path),
    build_manifest_revision(manifest, run).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest-dependencies"),
    verified_member(receipt, m, 1, revision), verified_member(receipt, m, 2, path),
    build_manifest__revision(manifest, revision), build_manifest__path(manifest, path),
    build_manifest_revision(manifest, run).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest-dependency"),
    verified_member(receipt, m, 1, revision), verified_member(receipt, m, 2, path),
    verified_member(receipt, m, 3, folder), build_manifest__revision(manifest, revision),
    build_manifest__path(manifest, path), build_dependency__kind(edge, "manifest"),
    build_dependency__manifest(edge, manifest), build_valid_dependency(edge, run, dependency, consumer),
    build_component__folder(dependency, folder).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "file-dependency"),
    verified_member(receipt, m, 1, dependency_folder), verified_member(receipt, m, 2, consumer_folder),
    build_dependency__kind(edge, "file_reader"), build_valid_dependency(edge, run, dependency, consumer),
    build_component__folder(dependency, dependency_folder), build_component__folder(consumer, consumer_folder).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "test-file"),
    verified_member(receipt, m, 1, path), build_test_file__path(file, path), build_test_file__component(file, component),
    build_component__run(component, run).
build_recorded_member(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "suite"),
    verified_member(receipt, m, 1, folder), build_component__folder(component, folder),
    build_component__run(component, run).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "changed-path"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "path-readers"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "path-reader"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest-dependencies"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "manifest-dependency"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "file-dependency"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "test-file"),
    !build_recorded_member(run, m).
build_full_selection(run, m) :- build_covered(run, receipt), verified_member(receipt, m, 0, "suite"),
    !build_recorded_member(run, m).

// Each recorded changed path, reader edge and dependency edge needs its admitted member; otherwise the
// selection is full (decisions/scoped-completeness.md section 3 compares both directions).
build_changed_member(receipt, path) :- verified_member(receipt, m, 0, "changed-path"),
    verified_member(receipt, m, 1, path).
build_reader_member(receipt, path, kind, folder) :- verified_member(receipt, m, 0, "path-reader"),
    verified_member(receipt, m, 1, path), verified_member(receipt, m, 2, kind), verified_member(receipt, m, 3, folder).
build_manifest_dependency_member(receipt, revision, path, folder) :-
    verified_member(receipt, m, 0, "manifest-dependency"), verified_member(receipt, m, 1, revision),
    verified_member(receipt, m, 2, path), verified_member(receipt, m, 3, folder).
build_file_dependency_member(receipt, dependency, consumer) :- verified_member(receipt, m, 0, "file-dependency"),
    verified_member(receipt, m, 1, dependency), verified_member(receipt, m, 2, consumer).
build_full_selection(run, change) :- build_covered(run, receipt), build_path__run(change, run),
    build_path__path(change, path), !build_changed_member(receipt, path).
build_full_selection(run, reader) :- build_covered(run, receipt), build_path_read(reader, run, change, component, kind),
    build_path__path(change, path), build_component__folder(component, folder),
    !build_reader_member(receipt, path, kind, folder).
build_full_selection(run, edge) :- build_covered(run, receipt), build_valid_dependency(edge, run, dependency, consumer),
    build_dependency__kind(edge, "manifest"), build_dependency__manifest(edge, manifest),
    build_manifest__revision(manifest, revision), build_manifest__path(manifest, path),
    build_component__folder(dependency, folder), !build_manifest_dependency_member(receipt, revision, path, folder).
build_full_selection(run, edge) :- build_covered(run, receipt), build_valid_dependency(edge, run, dependency, consumer),
    build_dependency__kind(edge, "file_reader"), build_component__folder(dependency, dependency_folder),
    build_component__folder(consumer, consumer_folder),
    !build_file_dependency_member(receipt, dependency_folder, consumer_folder).

// A changed path narrows the selection only through an admitted reader edge or a readerless witness.
build_path_accounted(run, path) :- build_covered(run, receipt), build_mapped_reader(receipt, path).
build_path_accounted(run, path) :- build_readerless_path(run, path, receipt).
build_full_selection(run, path) :- build_covered(run, receipt), verified_member(receipt, m, 0, "changed-path"),
    verified_member(receipt, m, 1, path), !build_path_accounted(run, path).

build_selected_job(run, component, path) :- build_selection_covered(run),
    build_path_read(reader, run, path, component, "direct").
build_selected_job(run, component, path) :- build_selection_covered(run), build_affected(run, component, path).
build_selected_job(run, component, reason) :- build_full_selection(run, reason),
    build_component__run(component, run).
// An incomplete captured suite inventory falls back to the suites of the admitted build receipts.
build_known_folder(run, folder) :- build_component__run(component, run), build_component__folder(component, folder).
build_selected_job(run, folder, reason) :- build_full_selection(run, reason), build_receipt(receipt),
    verified_member(receipt, m, 0, "suite"), verified_member(receipt, m, 1, folder), !build_known_folder(run, folder).

.output build_selected_job
.output build_full_selection
.output build_readerless_path
