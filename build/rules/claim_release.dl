.decl build_claim_delete_attempt(run: symbol, branch: symbol, generation: symbol, sent: number, outcome: symbol)
.decl build_claim_delete_effective(run: symbol, branch: symbol, generation: symbol, sent: number)
.decl build_claim_ref_absent(run: symbol, branch: symbol, tick: number)
.decl build_claim_ref_present_read(read: symbol, run: symbol, branch: symbol, tick: number)
.decl build_claim_ref_named(read: symbol)
.decl build_claim_ref_present_unnamed(run: symbol, branch: symbol, tick: number)
.decl build_claim_ref_present(run: symbol, branch: symbol, tick: number, generation: symbol)
.decl build_claim_ref_present_at(run: symbol, branch: symbol, tick: number)
.decl build_claim_settling_read(run: symbol, branch: symbol, generation: symbol, sent: number, tick: number, outcome: symbol)
.decl build_claim_settled_earlier(run: symbol, branch: symbol, generation: symbol, sent: number, tick: number)
.decl build_claim_first_settling(run: symbol, branch: symbol, generation: symbol, sent: number, outcome: symbol)
.decl build_claim_released(run: symbol, branch: symbol, generation: symbol, reason: symbol)
.decl build_claim_release_discarded(run: symbol, branch: symbol, reason: symbol)
.decl build_claim_release_settled(run: symbol, branch: symbol)
.decl build_claim_still_present(run: symbol, branch: symbol)
.decl build_claim_release_pending(run: symbol, branch: symbol, reason: symbol)

// A delete attempt counts only in the verified run that recorded it.
build_claim_delete_attempt(run, branch, generation, sent, outcome) :- build_verified_cut(run),
    build_claim_delete__run(delete, run), build_claim_delete__branch(delete, branch),
    build_claim_delete__generation(delete, generation), build_claim_delete__sent_at(delete, sent),
    build_claim_delete__outcome(delete, outcome), build_claim_delete__source(delete, source), source != "".
// A sent or unknown answer may have deleted the ref, so only a readback can settle it.
build_claim_delete_effective(run, branch, generation, sent) :- build_claim_delete_attempt(run, branch, generation, sent, "sent").
build_claim_delete_effective(run, branch, generation, sent) :-
    build_claim_delete_attempt(run, branch, generation, sent, "unknown").

// A ref read counts only with the receipt of its complete listing, in its own run at its own tick.
build_claim_ref_absent(run, branch, tick) :- build_claim_ref_read__run(read, run),
    build_claim_ref_read__branch(read, branch), build_claim_ref_read__observed_at(read, tick),
    build_claim_ref_read__state(read, "absent"), build_claim_ref_read__source(read, source), source != "",
    build_claim_ref_read__receipt(read, receipt), loop_sweep_receipt__run(receipt, run),
    loop_sweep_receipt__event_time(receipt, tick).
// The generation of a present read is optional in the schema. A present read without one still shows the
// branch at its tick, so it blocks a release there; it can neither confirm nor discard one.
build_claim_ref_present_read(read, run, branch, tick) :- build_claim_ref_read__run(read, run),
    build_claim_ref_read__branch(read, branch), build_claim_ref_read__observed_at(read, tick),
    build_claim_ref_read__state(read, "present"), build_claim_ref_read__source(read, source), source != "",
    build_claim_ref_read__receipt(read, receipt), loop_sweep_receipt__run(receipt, run),
    loop_sweep_receipt__event_time(receipt, tick).
build_claim_ref_present(run, branch, tick, generation) :- build_claim_ref_present_read(read, run, branch, tick),
    build_claim_ref_read__generation(read, generation).
build_claim_ref_named(read) :- build_claim_ref_read__generation(read, generation).
build_claim_ref_present_unnamed(run, branch, tick) :- build_claim_ref_present_read(read, run, branch, tick),
    !build_claim_ref_named(read).
build_claim_ref_present_at(run, branch, tick) :- build_claim_ref_present_read(read, run, branch, tick).

// A settling read is a later receipted read of the same run that Confirm or DiscardConfirmation in the model
// could act on: absent with no present read at its tick, or present at another generation.
build_claim_settling_read(run, branch, generation, sent, tick, "released") :-
    build_claim_delete_effective(run, branch, generation, sent), build_claim_ref_absent(run, branch, tick), tick > sent,
    !build_claim_ref_present_at(run, branch, tick).
build_claim_settling_read(run, branch, generation, sent, tick, "replaced") :-
    build_claim_delete_effective(run, branch, generation, sent), build_claim_ref_present(run, branch, tick, other),
    tick > sent, other != generation.
build_claim_settled_earlier(run, branch, generation, sent, tick) :-
    build_claim_settling_read(run, branch, generation, sent, tick, _),
    build_claim_settling_read(run, branch, generation, sent, earlier, _), earlier < tick.
// The model leaves pending on its first Confirm or DiscardConfirmation, so the first settling read decides.
// At one tick a settling read is either absent or present, never both, so the two outcomes exclude each other.
build_claim_first_settling(run, branch, generation, sent, outcome) :-
    build_claim_settling_read(run, branch, generation, sent, tick, outcome),
    !build_claim_settled_earlier(run, branch, generation, sent, tick).

// The model's Confirm: the first settling read is absent.
build_claim_released(run, branch, generation, "absent-after-delete") :-
    build_claim_first_settling(run, branch, generation, _, "released").

// The model's DiscardConfirmation: the first settling read shows the branch at another generation.
build_claim_release_discarded(run, branch, "replaced") :- build_claim_first_settling(run, branch, _, _, "replaced").
build_claim_release_discarded(run, branch, "delete-refused") :- build_claim_delete_attempt(run, branch, _, _, "refused").

build_claim_release_settled(run, branch) :- build_claim_released(run, branch, _, _).
build_claim_release_settled(run, branch) :- build_claim_release_discarded(run, branch, _).

build_claim_still_present(run, branch) :- build_claim_delete_effective(run, branch, generation, sent),
    build_claim_ref_present(run, branch, tick, generation), tick > sent.
build_claim_still_present(run, branch) :- build_claim_delete_effective(run, branch, _, sent),
    build_claim_ref_present_unnamed(run, branch, tick), tick > sent.
build_claim_release_pending(run, branch, "still-present") :- build_claim_delete_effective(run, branch, _, _),
    !build_claim_release_settled(run, branch), build_claim_still_present(run, branch).
build_claim_release_pending(run, branch, "readback-missing") :- build_claim_delete_effective(run, branch, _, _),
    !build_claim_release_settled(run, branch), !build_claim_still_present(run, branch).
