@locale en
---
# Sentences of std-time, neutral. A domain replaces them with a message of the same id (S14).
arrow.total = {{Every {$kind} has exactly one {$arrow}.}}
arrow.partial = {{Every {$kind} has at most one {$arrow}.}}
attribute.total = {{Every {$kind} has exactly one {$attribute}.}}
attribute.partial = {{Every {$kind} has at most one {$attribute}.}}
arrow.many.partial = {{Every {$kind} can have more than one {$arrow}.}}
attribute.many.partial = {{Every {$kind} can have more than one {$attribute}.}}
is_a = {{Every {$kind} is a {$parent}.}}
unique_key = {{{$key} belongs to at most one {$kind}.}}
path_equation = {{For every {$kind}: {$equation}.}}
# One sentence per rule (rules/time.dl): rule.<rule-id>, with the rule's variables.
rule.start_stated = {{{$i} starts at {$s}.}}
rule.end_stated = {{{$i} ends at {$e}.}}
rule.extension_stated = {{The extension of {$i} runs until {$x}.}}
rule.known_from_stated = {{{$i} is known from {$k}.}}
rule.start_not_recorded = {{On {$l}, nobody recorded a start for {$i}, nor that it has none: its start is unknown.}}
rule.end_not_recorded = {{On {$l}, nobody recorded an end for {$i}, nor that it has none: its end is unknown.}}
rule.known_from_not_recorded = {{On {$l}, nobody recorded from which position {$i} is known: whether it was known at a reference is unknown.}}
rule.interval_inverted = {{{$i} ends at {$e}, which is not after its start {$s}.}}
rule.bound_contradicted_1 = {{{$i} starts at {$s}, and is also stated to have no start.}}
rule.bound_contradicted_2 = {{{$i} ends at {$e}, and is also stated to have no end.}}
rule.extension_inverted = {{The extension of {$i} stops at {$x}, before its end {$e}.}}
rule.extension_without_end_1 = {{{$i} states an extension until {$x}, and nobody recorded the end it extends.}}
rule.extension_without_end_2 = {{{$i} states an extension until {$x}, and is stated to have no end.}}
rule.series_across_axes = {{{$a} and {$b} are in the series {$q}, yet {$a} lies on {$l} and {$b} on {$m}.}}
rule.begun_at_1 = {{{$i} starts at {$s}, at or before {$r} (position {$p}).}}
rule.begun_at_2 = {{{$i} is stated to have no start, so it has begun at {$r} (position {$p}).}}
rule.ended_at = {{{$i} ends at {$e}, at or before {$r} (position {$p}).}}
rule.holds_at_1 = {{{$i} holds at {$r} (position {$p}): it has begun, and its end {$e} lies after that position.}}
rule.holds_at_2 = {{{$i} holds at {$r} (position {$p}): it has begun, and is stated to have no end.}}
rule.in_extension = {{{$i} has ended at {$r} (position {$p}), and its extension runs until {$x}.}}
rule.known_at = {{{$i} is known from {$k}, at or before {$r} (position {$p}).}}
rule.judgement_1 = {{{$i} ended at {$e}, at or before {$r}, and states no extension.}}
rule.judgement_2 = {{{$i} has ended at {$r} (position {$p}), and its extension stopped at {$x}.}}
rule.judgement_3 = {{{$i} has ended at {$r}, and is in its extension until {$x}.}}
rule.judgement_4 = {{{$i} starts at {$s}, after {$r} (position {$p}), and ends at {$e}: at {$r} it has not begun.}}
rule.judgement_5 = {{{$i} starts at {$s}, after {$r} (position {$p}), and is stated to have no end: at {$r} it has not begun.}}
rule.judgement_6 = {{{$i} starts at {$s}, after {$r} (position {$p}), and nobody recorded its end: at {$r} it has not begun.}}
rule.judgement_7 = {{{$i} has begun at {$r} (position {$p}), and nobody recorded an end for it, nor that it has none: whether it still holds is unknown.}}
rule.judgement_8 = {{On {$l}, nobody recorded a start or an end for {$i}, nor that it has none: at {$r} it is unknown how it stands.}}
rule.judgement_9 = {{{$i} ends at {$e}, after {$r} (position {$p}), and nobody recorded its start, nor that it has none: whether it holds at {$r} is unknown.}}
rule.judgement_10 = {{{$i} is stated to have no end, and nobody recorded its start, nor that it has none: on {$l}, whether it holds at {$r} is unknown.}}
rule.judgement_11 = {{{$i} holds at {$r} (position {$p}), and is stated to have no end, so nothing says when it stops.}}
rule.judgement_12 = {{{$i} holds at {$r} and ends at {$e}, within {$h} of {$r} (position {$p}).}}
rule.judgement_13 = {{{$i} holds at {$r} and ends at {$e}, more than {$h} after {$r} (position {$p}).}}
rule.span = {{{$i} runs from {$s} until {$e} in the series {$q}.}}
rule.allen_1 = {{{$a} ends at {$e}, before {$b} starts at {$t}.}}
rule.allen_2 = {{{$a} ends at {$e}, where {$b} starts.}}
rule.allen_3 = {{{$a} starts at {$s}, {$b} starts at {$t} inside it, and {$a} ends at {$e}, before {$b} ends at {$f}.}}
rule.allen_4 = {{{$a} and {$b} both start at {$s}, and {$a} ends at {$e}, before {$b} ends at {$f}.}}
rule.allen_5 = {{{$a} starts at {$s}, after {$b} starts at {$t}, and ends at {$e}, before {$b} ends at {$f}.}}
rule.allen_6 = {{{$a} starts at {$s}, after {$b} starts at {$t}, and both end at {$e}.}}
rule.allen_7 = {{{$a} and {$b} both run from {$s} until {$e}.}}
rule.allen_8 = {{{$a} starts at {$s}, after {$b} ends at {$f}.}}
rule.allen_9 = {{{$a} starts at {$s}, where {$b} ends.}}
rule.allen_10 = {{{$b} starts at {$t}, {$a} starts at {$s} inside it, and {$b} ends at {$f}, before {$a} ends at {$e}.}}
rule.allen_11 = {{{$a} and {$b} both start at {$s}, and {$b} ends at {$f}, before {$a} ends at {$e}.}}
rule.allen_12 = {{{$b} starts at {$t}, after {$a} starts at {$s}, and ends at {$f}, before {$a} ends at {$e}.}}
rule.allen_13 = {{{$b} starts at {$t}, after {$a} starts at {$s}, and both end at {$e}.}}
# Explanation questions: the generic grounds and reach, narrowed to intervals and references.
explain.time_grounds = Why it stands so
explain.time_grounds.question = {{Why does {$element} stand so at the reference?}}
explain.time_reach = What holds here
explain.time_reach.question = {{What holds at {$element}?}}
explain.outside = Outside your view
explain.more = More from here
explain.empty = {{No answer for {$element}.}}
# The standard bitemporal staircase reading.
staircase.bitemporal = Bitemporal staircase
