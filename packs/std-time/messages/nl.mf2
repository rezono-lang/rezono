@locale nl
---
# Zinnen van std-time, neutraal. Een domein vervangt ze met een bericht met dezelfde id (S14).
arrow.total = {{Elk {$kind} heeft precies één {$arrow}.}}
arrow.partial = {{Elk {$kind} heeft hoogstens één {$arrow}.}}
attribute.total = {{Elk {$kind} heeft precies één {$attribute}.}}
attribute.partial = {{Elk {$kind} heeft hoogstens één {$attribute}.}}
arrow.many.partial = {{Elk {$kind} kan meer dan één {$arrow} hebben.}}
attribute.many.partial = {{Elk {$kind} kan meer dan één {$attribute} hebben.}}
is_a = {{Elk {$kind} is een {$parent}.}}
unique_key = {{{$key} hoort bij hoogstens één {$kind}.}}
path_equation = {{Voor elk {$kind}: {$equation}.}}
# Eén zin per regel (rules/time.dl): rule.<regel-id>, met de variabelen van de regel.
rule.start_stated = {{{$i} begint op {$s}.}}
rule.end_stated = {{{$i} eindigt op {$e}.}}
rule.extension_stated = {{De verlenging van {$i} loopt tot {$x}.}}
rule.known_from_stated = {{{$i} is bekend vanaf {$k}.}}
rule.start_not_recorded = {{Op {$l} heeft niemand een begin van {$i} vastgelegd, en ook niet dat het er geen heeft: het begin is onbekend.}}
rule.end_not_recorded = {{Op {$l} heeft niemand een einde van {$i} vastgelegd, en ook niet dat het er geen heeft: het einde is onbekend.}}
rule.known_from_not_recorded = {{Op {$l} heeft niemand vastgelegd vanaf welke positie {$i} bekend is: of het op een peildatum bekend was is onbekend.}}
rule.interval_inverted = {{{$i} eindigt op {$e}, en dat ligt niet na het begin {$s}.}}
rule.bound_contradicted_1 = {{{$i} begint op {$s}, en er staat ook dat het geen begin heeft.}}
rule.bound_contradicted_2 = {{{$i} eindigt op {$e}, en er staat ook dat het geen einde heeft.}}
rule.extension_inverted = {{De verlenging van {$i} stopt op {$x}, vóór het einde {$e}.}}
rule.extension_without_end_1 = {{{$i} noemt een verlenging tot {$x}, en niemand heeft het einde vastgelegd dat verlengd wordt.}}
rule.extension_without_end_2 = {{{$i} noemt een verlenging tot {$x}, en er staat dat het geen einde heeft.}}
rule.series_across_axes = {{{$a} en {$b} staan in de reeks {$q}, maar {$a} ligt op {$l} en {$b} op {$m}.}}
rule.begun_at_1 = {{{$i} begint op {$s}, op of vóór {$r} (positie {$p}).}}
rule.begun_at_2 = {{Er staat dat {$i} geen begin heeft, dus het is begonnen op {$r} (positie {$p}).}}
rule.ended_at = {{{$i} eindigt op {$e}, op of vóór {$r} (positie {$p}).}}
rule.holds_at_1 = {{{$i} geldt op {$r} (positie {$p}): het is begonnen, en het einde {$e} ligt na die positie.}}
rule.holds_at_2 = {{{$i} geldt op {$r} (positie {$p}): het is begonnen, en er staat dat het geen einde heeft.}}
rule.in_extension = {{{$i} is geëindigd op {$r} (positie {$p}), en de verlenging loopt tot {$x}.}}
rule.known_at = {{{$i} is bekend vanaf {$k}, op of vóór {$r} (positie {$p}).}}
rule.judgement_1 = {{{$i} is geëindigd op {$e}, op of vóór {$r}, en noemt geen verlenging.}}
rule.judgement_2 = {{{$i} is geëindigd op {$r} (positie {$p}), en de verlenging is gestopt op {$x}.}}
rule.judgement_3 = {{{$i} is geëindigd op {$r}, en zit in de verlenging tot {$x}.}}
rule.judgement_4 = {{{$i} begint op {$s}, na {$r} (positie {$p}), en eindigt op {$e}: op {$r} is het nog niet begonnen.}}
rule.judgement_5 = {{{$i} begint op {$s}, na {$r} (positie {$p}), en heeft volgens de opgave geen einde: op {$r} is het nog niet begonnen.}}
rule.judgement_6 = {{{$i} begint op {$s}, na {$r} (positie {$p}), en niemand heeft het einde vastgelegd: op {$r} is het nog niet begonnen.}}
rule.judgement_7 = {{{$i} is begonnen op {$r} (positie {$p}), en niemand heeft een einde vastgelegd, en ook niet dat het er geen heeft: of het nog geldt is onbekend.}}
rule.judgement_8 = {{Op {$l} heeft niemand een begin of een einde van {$i} vastgelegd, en ook niet dat het er geen heeft: op {$r} is onbekend hoe het ervoor staat.}}
rule.judgement_9 = {{{$i} eindigt op {$e}, na {$r} (positie {$p}), en niemand heeft het begin vastgelegd, en ook niet dat het er geen heeft: of het op {$r} geldt is onbekend.}}
rule.judgement_10 = {{Er staat dat {$i} geen einde heeft, en niemand heeft het begin vastgelegd, en ook niet dat het er geen heeft: op {$l} is onbekend of het op {$r} geldt.}}
rule.judgement_11 = {{{$i} geldt op {$r} (positie {$p}), en heeft volgens de opgave geen einde, dus niets zegt wanneer het stopt.}}
rule.judgement_12 = {{{$i} geldt op {$r} en eindigt op {$e}, binnen {$h} na {$r} (positie {$p}).}}
rule.judgement_13 = {{{$i} geldt op {$r} en eindigt op {$e}, meer dan {$h} na {$r} (positie {$p}).}}
rule.span = {{{$i} loopt van {$s} tot {$e} in de reeks {$q}.}}
rule.allen_1 = {{{$a} eindigt op {$e}, voordat {$b} begint op {$t}.}}
rule.allen_2 = {{{$a} eindigt op {$e}, waar {$b} begint.}}
rule.allen_3 = {{{$a} begint op {$s}, {$b} begint daarbinnen op {$t}, en {$a} eindigt op {$e}, voordat {$b} eindigt op {$f}.}}
rule.allen_4 = {{{$a} en {$b} beginnen allebei op {$s}, en {$a} eindigt op {$e}, voordat {$b} eindigt op {$f}.}}
rule.allen_5 = {{{$a} begint op {$s}, nadat {$b} begint op {$t}, en eindigt op {$e}, voordat {$b} eindigt op {$f}.}}
rule.allen_6 = {{{$a} begint op {$s}, nadat {$b} begint op {$t}, en allebei eindigen op {$e}.}}
rule.allen_7 = {{{$a} en {$b} lopen allebei van {$s} tot {$e}.}}
rule.allen_8 = {{{$a} begint op {$s}, nadat {$b} eindigt op {$f}.}}
rule.allen_9 = {{{$a} begint op {$s}, waar {$b} eindigt.}}
rule.allen_10 = {{{$b} begint op {$t}, {$a} begint daarbinnen op {$s}, en {$b} eindigt op {$f}, voordat {$a} eindigt op {$e}.}}
rule.allen_11 = {{{$a} en {$b} beginnen allebei op {$s}, en {$b} eindigt op {$f}, voordat {$a} eindigt op {$e}.}}
rule.allen_12 = {{{$b} begint op {$t}, nadat {$a} begint op {$s}, en eindigt op {$f}, voordat {$a} eindigt op {$e}.}}
rule.allen_13 = {{{$b} begint op {$t}, nadat {$a} begint op {$s}, en allebei eindigen op {$e}.}}
# Uitlegvragen: de algemene grondslag en het bereik, toegespitst op intervallen en peilpunten.
explain.time_grounds = Waarom het zo staat
explain.time_grounds.question = {{Waarom staat {$element} zo op het peilpunt?}}
explain.time_reach = Wat hier geldt
explain.time_reach.question = {{Wat geldt op {$element}?}}
explain.outside = Buiten je zicht
explain.more = Verder vanaf hier
explain.empty = {{Geen antwoord voor {$element}.}}
# De standaard bitemporele traplezing.
staircase.bitemporal = Bitemporele trap
