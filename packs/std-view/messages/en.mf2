@locale en
---
# Labels of std-view in ICU MessageFormat 2. Every id here is in every language of std-view.
status.valid = valid
status.changed = changed
status.violated = violated
status.unknown = unknown
status.not_applicable = not applicable
status.absent = absent, checked
# The value states a calculation step names (contracts/value.yaml) that are no status of their own.
status.known = known
status.invalid = invalid
# Shown in place of a text the pack does not give: never a message id.
text.missing = (text missing)
tone.positive = positive
tone.neutral = neutral
tone.caution = caution
tone.negative = negative
tone.unknown = unknown
# The legend of Rezono: what is known about a value, the same sign in every pack and every theme.
sign.origin_decision = origin: decision
sign.origin_vendor = origin: vendor or law
sign.origin_design = origin: design
sign.origin_observation = origin: observation
sign.derived = derived
sign.assumption = assumption
sign.drift = differs from the reference
sign.screened = not visible to your role
sign.proposal = proposal
sign.sealed = sealed
sign.supposed = supposed

lens.questions = Questions
# The row page: what Rezono concludes first, then the facts, then the relations to other elements.
row.conclusions = What Rezono concludes
row.conclusions_more = {{There are more: {$relations}.}}
row.calculations = Calculated
calc.stop = ← the calculation stops here
row.facts = Facts
row.relations = Relations
# The lead of a row page: the conclusion, why it holds here, under which conditions, what the reader can do next.
lead.title = The conclusion in short
lead.conclusion = Concluded
lead.grounds = Why it holds here
lead.conditions = As long as
lead.next = What you can do
lead.value = {{{$element}: {$relation} {$value}}}
lead.row = {{{$relation}: {$row}}}
lead.absent = {{there is no {$relation} ({$row})}}
lead.as_of = {{the facts stay as known on {$date}}}
lead.fill = {{fill in {$value}}}
lead.propose = propose a change
lead.more = .input {$count :number} .match $count one {{and {$count} more ground in the proof}} * {{and {$count} more grounds in the proof}}

fold.current = IN FORCE
fold.proposal = WITH PROPOSAL

key.title = Key to signs
key.proof = chosen proof
key.hatch = unknown, never zero
key.unknown_end = connection with an unknown end
key.screened = screened step
key.extension = extension
key.arrow = {{{$kind} → {$slot}}}
key.fact = fact (upright)
key.conclusion = conclusion (italic)
key.selection = selection
key.specimen = Aa
key.contour = {{contour: each line is a step of 1/{$levels} of the highest peak}}
key.coast = {{coast: one hill per {$member}}}
key.ring = {{ring: share per status of the {$member}}}
key.image = {{image: {$slot} per {$kind}}}
key.cell = {{cell: how many {$relation} run from the row to the column; a cell of one opens the proof}}
key.cell_blank = empty cell: none
key.cell_unknown = empty cell: unknown, not zero (the source is open)
key.cell_size = area: share of the largest cell
key.band_rows = band: the thicker, the more rows
key.band_quantity = {{band: the thicker, the more {$quantity}}}
key.band_gap = required, without a decision that covers it
key.open_derived = {{{$line}: a missing line may be unknown (the relation reads an open source)}}
key.open_stored = {{{$line}: a missing line is unknown, not none}}
key.open_recorded = {{{$line}: {$recorded}; a missing line is unknown, not none}}
key.boundary = {{boundary: {$name}}}
key.bar = bar: filled is a fact, outlined a conclusion
key.lane = lane
key.scale = {{{$meaning}: height by (value − {$zero})^{$exponent}, with the exact value beside it}}

sheet.index = Overview
sheet.kind = {{{$kind} {$id}}}
name.separator = {{ · }}
value.separator = {{, }}
value.reason = {{{$value} ({$reason})}}
# MOD18: a slot with no row in a closed world; unknown stays `status.unknown`.
value.none = no value
# Number typography (docs/gui.md, Number typography): the real minus sign, the sign for rounded (exact has no sign) and the fraction.
number.minus = −
number.rounded = ≈
number.fraction = {{{$numerator}⁄{$denominator}}}
sheet.answer = {{Answer about {$value}}}
sheet.impact = {{Impact of {$proposal}}}
sheet.proposed = {{Proposal {$key}}}
sheet.packs = Packs

cartouche.title = Sheet
cartouche.pack = Pack
cartouche.manifest = Manifest
cartouche.knowledge_time = Knowledge time
cartouche.zoom = Scale
# At the lowest level the sheet shows every element; above it one area stands for {$scale} units.
cartouche.zoom_value = .input {$scale :number} .match $scale 1 {{every element apart}} * {{1 : {$scale}}}
cartouche.manifest_value = {{{$id} · epoch {$epoch}}}
cartouche.time_value = {{{$time} UTC}}

# The answer to an explanation question (std-explain): as a table, per page; the heading is the question's sentence.
answer.distance = Step
answer.value = Value
answer.ring = {{Ring {$distance}}}
answer.next = Next page
answer.close = Close
answer.sheet = As a sheet of its own
answer.compass = Compass
answer.premises = First premise that does not hold
answer.candidates = What it would give
answer.cut = Not everything is shown.
scale.samples = Published grid values, in grid order; values in between are not computed.
scale.value = Grid value
scale.status = Status
scale.difference = Published difference
scale.green = Checks passed
scale.warning = Warning
scale.red = Checks failed
scale.unavailable = Status not available
scale.not_computed = Not computed yet
scale.no_difference = No difference data available
scale.counts = {{{$relation}: {$added} added, {$removed} removed, {$changed} changed}}
scale.warning_glyph = !
scale.unavailable_glyph = ?
scale.not_computed_glyph = …
gap.premise = {{For {$node}: {$relation} {$item}.}}
gap.item.positive = is missing
gap.item.negative = exists, but may not
gap.item.condition = condition does not hold
gap.item.assignment = calculation fails
gap.item.aggregate = count does not hold
gap.candidate = {{Set {$relation} {$key} {$change}.}}
gap.insert = added
gap.delete = removed
gap.sufficient = enough
gap.to_test = to test as a proposal
route.screened = screened step
route.negative = {{no {$relation}}}
# A calculated value: rule@version#definition and the outcome, then the steps from the witness.
route.calc = {{Calculated by {$rule}@{$version}#{$definition}: {$value}}}
route.calc.none = {{Calculated by {$rule}: {$value}}}
route.calc.path = Path
route.calc.uses = Uses
route.calc.fact = {{fact {$fact}}}
route.calc.parameter = {{parameter {$parameter}}}
route.calc.rule = {{calculation rule {$rule}}}
route.calc.op = {{operation {$op}}}
route.calc.value = Value
route.calc.state = State
route.calc.reason = Reason
route.calc.element = {{(element {$element})}}
# A named outcome: known; when unknown, the reason stands there as a sentence (the pack's reason.<reason>).
outcome.known = known
outcome.absent = not derived

waterfall.not_closed = The sum does not close.
# The contributions of an aggregate in an answer: what each row gives, and the bridge of a sum.
waterfall.steps = {{Contributions to {$relation}}}
waterfall.sum = {{Sum of {$relation}}}
waterfall.rest = .input {$count :number} .match $count one {{The rest ({$count} row)}} * {{The rest ({$count} rows)}}
waterfall.unread = No bridge: this role does not read every row of the group in full, so the parts give no total here.
waterfall.row = Row
waterfall.gives = Contributes
waterfall.total = Total
finding.sum_not_closed = {{Blocked: the parts of {$value} do not add up to the total.}}
finding.mixed_currency = {{Blocked: a sum in more than one currency ({$currencies}).}}

map.title = Map
map.cluster = .input {$count :number} .match $count one {{{$count} element}} * {{{$count} elements}}
map.range = {{{$first} … {$last}}}
map.stub = {{→ {$island}: {$count}}}
map.stub_in = {{← {$island}: {$count}}}
map.up = Zoom out
map.absent = No map was made for this manifest.
map.more = {{More {$arrow} to {$element}}}
relief.title = Relief
relief.absent = No relief was made for this manifest.
relief.region = Region
relief.shares = Status
relief.count = number of elements
relief.elements = elements
flow.absent = No flow was made for this manifest.
matrix.absent = No matrix was made for this manifest.
matrix.total = Total
matrix.total_open = Total, known so far
timeline.absent = No timeline was made for this manifest.
timeline.as_of = {{knowledge time {$date}}}
timeline.marks = Events
nest.absent = No nest was made for this manifest.
nest.apart = Apart: where this belongs is unknown
nest.apart_elsewhere = Some parts stand apart: where they belong is unknown.
report.empty = There are no cards here.
report.next = Next cards
report.comparison.equal = Equal
report.comparison.different = Different
report.comparison.not_compared = Not compared
report.comparison.class = Outcome
report.comparison.rows = Rows
report.comparison.partial = Your role reads part of this relation, so there are no totals here.
report.comparison.why = Why
report.comparison.none = There are no rows here.
report.comparison.next = Next rows
reader.title = Questions
reader.eyebrow = Question
reader.why = Why?
reader.none = There are no rows here.
reader.partial = Your role reads part of this answer, so rows may be missing here.
reader.more = More rows follow.
reader.next = Next rows
table.name = Element
table.empty = There are no rows here.
table.unbound = These rows no longer belonged to one state. Reload the page.
table.next = Next rows
flow.lanes = Lanes
flow.groups = Groups
flow.lane = Lane
flow.line = Line
flow.parts = Parts
flow.part = {{part {$n} of {$of}}}
flow.followed = {{followed · {$quantity}}}
flow.recorded = {{{$n} of {$m} recorded}}
flow.recorded_rows = {{{$n} recorded}}
flow.from = From
flow.to = To
flow.rows = Rows
flow.quantity = Quantity
flow.in = in
flow.out = out
flow.route = Route
flow.route_show = show
flow.route_shown = shown
flow.routes_more = More routes start here than this page shows.
flow.route_steps = Steps of this route that are no line here:
impact.count = .input {$count :number} .match $count one {{{$count} value added, removed or changed}} * {{{$count} values added, removed or changed}}
impact.added = added
impact.removed = removed
impact.changed = changed
impact.absent = does not exist
# The effect map (docs/interaction.md, 3. Ripple): rings by distance, sectors per relation, a sign per change.
sheet.effect = {{Effect map of {$what}}}
effect.of.proposal = {{proposal {$proposal}}}
effect.of.variant = {{variant {$variant} of {$sweep}}}
effect.link = Effect map
effect.change.added = added
effect.change.removed = removed
effect.change.changed = changed
effect.change.unchanged = unchanged
effect.change.outside = not said
effect.was = {{was {$was}}}
effect.key.added = added: the row is in the proposal only
effect.key.removed = removed: the row is in the base only
effect.key.changed = changed: another value; the table says what it was
effect.key.unchanged = shore: reached and unchanged; the ripple stops here
effect.key.outside = out of view: this role does not read it in full, so what changed there is not said
effect.key.ring = ring: the number of proof steps from what the delta itself changes; sector: the relation
effect.key.cluster = number: this many rows of this relation on this ring; the table names them
effect.key.ahead = lighter: further out than the ring shown
effect.cluster = .input {$count :number} .match $count one {{{$count} row}} * {{{$count} rows}}
effect.shore = .input {$count :number} .match $count one {{{$count} row on the shore: reached and unchanged}} * {{{$count} rows on the shore: reached and unchanged}}
effect.incomplete = {{Incomplete: {$why}. A changed row without a ring gets none.}}
effect.incomplete.depth = the ripple stopped at its depth
effect.incomplete.budget = the ripple stopped at the gate's limit
effect.incomplete.not_read_in_full = this role does not read part of the difference in full
effect.incomplete.paged = the map shows only part of the answer: not every page of it came in
effect.incomplete.unsaid = the answer does not say it is complete
effect.none.question = This pack asks no question that gives an effect map.
effect.none.served = There is no effect map here: the difference is not published for this role (yet), or it does not belong to the newest publication.
effect.rings = Rings
effect.ring.all = All rings
effect.ring.upto = {{Up to ring {$ring}}}
effect.table = The effect map as a table
effect.col.ring = Ring
effect.col.sector = Relation
effect.col.row = Row
effect.col.change = Change
attention.title = What asks for attention
attention.red = Checks not passed
attention.warning = Checks with a warning
attention.unavailable = Checks without an outcome
attention.proposals = Proposals on this manifest
attention.proposals_paged = more than one page; see the list
attention.elements = Elements you may read
attention.texts = Texts the pack does not give yet
attention.kinds = .input {$count :number} .match $count one {{{$count} kind}} * {{{$count} kinds}}
attention.checks_green = all checks passed
index.proposals = Proposals
index.proposals_next = Next proposals
index.rows = Elements
index.more = {{and {$count} more}}
islands.title = Overview
islands.own = {{{$kind} without a subkind}}
islands.island = Group
islands.count = Elements
islands.lines = Lines to other groups
islands.line = {{{$from} → {$to} ({$arrow}): {$count}}}
islands.line_label = {{{$arrow} {$count}}}
app.name = Rezono
# Navigation: the trail to a page, and the pack's declared views.
nav.trail = Trail
nav.views = Views
nav.schema = Schema and elements
packs.knowledge = {{knowledge of {$date}}}

# Proposals (docs/lifecycle.md): a new value becomes a pull request, through the access gate and CI.
enum.true = yes
enum.false = no
propose.submit = Propose
propose.title = {{New value for {$name}: {$value}}}
propose.title_stand = {{State {$proposal} proposed: {$names}}}
propose.stand = .input {$count :number} .match $count one {{Propose this state ({$count} value)}} * {{Propose this state ({$count} values)}}
propose.state.pending = Pending: the CI run makes the proposal.
propose.state.unknown = Uncertain: the Git host gave no answer. The proposal may already be running.
propose.state.open = Open: the proposal waits for review.
propose.state.merged = Merged: the change is on main.
propose.state.closed = Closed without a merge.
propose.state.absent = No proposal for this key.
propose.note.pending = The pull request appears after the CI run, usually within a few minutes. This page looks again by itself.
propose.note.impact = Impact follows: CI computes the proposal and publishes the proposal manifest. This page looks again by itself.
propose.pull_request = {{Pull request {$id} on the Git host}}
propose.impact = See the impact against the latest manifest
# Errors and refusals (AUD-W3): the text per status. The technical reason is in the server log, not on the screen.
error.status.400 = This address is not right: one of its parameters has an invalid form.
error.status.401 = You are not signed in. Sign in at the access gate and try again.
error.status.403 = Your role has no access to this viewer.
error.status.404 = Not found: this page does not exist, or your role does not read it.
error.status.500 = Something went wrong while making this page. The cause is in the server log.
error.status.501 = This version of the pack cannot be read per row here. Choose the newest version.
error.status.502 = The access gate gave no answer. The cause is in the server log.

propose.error.right = Your role may not make a proposal here.
propose.error.stale = There is a newer manifest by now. Reload the page and propose again.
propose.error.size = The proposal is too large.
propose.error.value = This value cannot be proposed like this.
propose.error.host = The Git host does not answer now. Try again later.
propose.error.empty = Enter a value.
propose.error.integer = A whole number, without a comma or a point.
propose.error.amount = An amount such as 1250.50: no more digits after the point than the currency has, without separators between the thousands.
propose.error.boolean = Choose yes or no.
propose.error.date = A date as yyyy-mm-dd.
propose.error.enum = Choose one of the values in the list.
propose.error.line = One line of text, without invisible characters.

# Editing on the row page (P8.1): the edit is a draft first and then becomes one proposal.
edit.open = Edit
edit.heading = Edit as a proposal
edit.review = Review the draft
edit.cancel = Cancel
edit.draft = Draft
edit.draft_note = Nothing is written: Propose makes a pull request, which is reviewed first.
edit.value = Value
edit.before = Now
edit.after = Proposed
edit.title = {{New values for {$element}: {$names}}}
edit.error.none = Nothing has changed.
edit.error.changed = The draft has changed since you reviewed it. Review the new draft and then propose again.

report.unavailable = Not available.

# Search (docs/gui.md, Search): by id and name, only in what the role reads.
search.title = Search
search.label = Search by id or name
search.submit = Search
search.empty = Type an id or a name.
search.none = Nothing found for this text.
search.total = {{{$count} found in {$manifest} for role {$role}}}
search.kinds = Kind
search.shown = {{{$shown} of {$total}}}
search.more = {{and {$count} more}}
search.ask = rather ask
search.reason = {{{$field}, {$fit}}}
search.field.id = id
search.field.name = name
search.fit.exact = exactly as typed
search.fit.whole = whole
search.fit.word = word
search.fit.part = part of a word
search.partial = Names were searched in the first rows of each kind; an exact id finds every element.
search.absent = No search index has been published for this role yet.

# The specimen (docs/gui.md, The specimen): every sign of std-view in use, on fixed, invented data.
specimen.title = Specimen of the visual language
specimen.intro = Every sign, every state, every line, every number and every letter Rezono uses, shown in use. This sheet is made from std-view; the examples are invented.
specimen.end = A sign on a sheet that is not on this sheet is a defect.
specimen.column.sign = Sign
specimen.column.meaning = Meaning
specimen.column.use = In use
specimen.column.token = In std-view
specimen.column.case = Case
specimen.column.shown = Shown as
specimen.legend = The legend of Rezono
specimen.legend.note = These signs mean the same in every pack and every theme. What we know comes before the domain.
specimen.states = States
specimen.states.note = Every state is three things at once: a tone, a sign and a word. If one drops away, the state stays readable.
specimen.lines = Hatching and lines
specimen.lines.note = A line or hatching on a sheet always has one of these meanings.
specimen.numbers = Numbers
specimen.numbers.note = Amounts are right-aligned in tabular figures: digits of the same rank stand under each other.
specimen.type = Type and measures
specimen.type.note = The typefaces, type sizes and line widths of a sheet, with their name in std-view.
specimen.lens = Questions
specimen.verbs = Verbs
specimen.verbs.note = Six verbs, the same at every value, in a fixed order, each with its key. A verb that can say nothing about a value is not there.
specimen.lens.note = One sign per form of answer; every question with that form gets it.
specimen.themes = Themes
specimen.themes.note = The same signs in every theme of the palette. The tints change, the meaning does not.
specimen.theme.light = light
specimen.theme.dark = dark
specimen.theme.print = print
specimen.theme.forced_colors = forced colours
specimen.arrow.default = connection
specimen.arrowhead = arrowhead: the direction of a connection
specimen.fold = the fold: on the left what holds, on the right the proposal
# Shared sentences for derived and proposed values.
specimen.use.derived = {{{$sign}}}
specimen.use.proposal = {{{$sign} · waiting for review}}
specimen.number.amount = Amount
specimen.number.larger = Larger amount, same column
specimen.number.unit = Unit in small capitals
specimen.number.exact = Exact: no sign
specimen.number.fraction = Fraction
specimen.number.negative = Negative: a real minus sign, never colour alone
specimen.number.unknown = Unknown: hatched, with the reason, never 0
specimen.number.not_applicable = Not applicable
specimen.number.total = Total, a conclusion: a line above, a double line below

# The sheet as an argument (docs/gui.md): the zones of a sheet and the six verbs at every value.
zone.context = Context
zone.rests = What it rests on
zone.missing = Missing
zone.differs = Differs
zone.twin = Show as a table
zone.verbs = Questions about this value
claim.texts_missing = .input {$count :number} .match $count one {{{$count} text is missing}} * {{{$count} texts are missing}}
attention.none = Nothing else asks for your attention today.
verb.why = Why
verb.depends = Depends on this
verb.missing = What is missing
verb.suppose = What if
verb.compare = Compare
verb.propose = Propose

# The home of a pack (the map and its six zones): the claim is one sentence from the attention cards.
home.eyebrow = {{Home · {$pack}}}
home.claim = .input {$count :number} .match $count one {{One thing asks for your attention: {$asks}.}} * {{{$count} things ask for your attention: {$asks}.}}
home.ask.red = .input {$count :number} .match $count one {{{$count} check not passed}} * {{{$count} checks not passed}}
home.ask.warning = .input {$count :number} .match $count one {{{$count} check with a warning}} * {{{$count} checks with a warning}}
home.ask.unavailable = .input {$count :number} .match $count one {{{$count} check without an outcome}} * {{{$count} checks without an outcome}}
home.ask.proposals = .input {$count :number} .match $count one {{{$count} proposal on this manifest}} * {{{$count} proposals on this manifest}}
home.ask.proposals_paged = proposals on more than one page
home.ask.texts = .input {$count :number} .match $count one {{{$count} text the pack does not give yet}} * {{{$count} texts the pack does not give yet}}
home.calm = All checks have passed; nothing else asks for your attention.
home.changed = Changed since your last visit

# The table twin of the row page: every value of the element in one table.
row.twin.name = Attribute
row.twin.value = Value
row.twin.state = State

# Your own publication form on the home of a pack: the schema id and the dataset hash in full, and each file.
home.form.title = Your data in publication form
home.form.schema = schema id
home.form.dataset = dataset hash
home.form.files = files
