scale.warning_glyph = !
scale.unavailable_glyph = ?
scale.not_computed_glyph = …
gap.premise = {{Voor {$node}: {$relation} {$item}.}}
gap.item.positive = ontbreekt
gap.item.negative = bestaat, maar mag niet
gap.item.condition = voorwaarde geldt niet
gap.item.assignment = berekening lukt niet
gap.item.aggregate = telling geldt niet
