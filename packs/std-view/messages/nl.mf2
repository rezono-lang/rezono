gap.sufficient = genoeg
gap.to_test = te toetsen als voorstel
route.screened = afgeschermde stap
route.negative = {{geen {$relation}}}
# Een berekende waarde (besluit W12): regel@versie#definitie en de uitkomst, dan de stappen uit de getuige.
route.calc = {{Berekend door {$rule}@{$version}#{$definition}: {$value}}}
