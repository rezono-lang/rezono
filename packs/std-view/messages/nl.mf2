route.calc.value = Waarde
route.calc.state = Toestand
route.calc.reason = Reden
route.calc.element = {{(element {$element})}}
# Een benoemde uitkomst (besluit W7): bekend; bij onbekend staat de reden er als zin (reason.<reden> van het pack).
outcome.known = bekend
outcome.absent = niet afgeleid

waterfall.not_closed = De som sluit niet.
# De bijdragen van een aggregaat in een antwoord (RV-V30): wat elke rij geeft, en de brug van een som.
waterfall.steps = {{Bijdragen van {$relation}}}
waterfall.sum = {{Som van {$relation}}}
waterfall.rest = .input {$count :number} .match $count one {{De rest ({$count} rij)}} * {{De rest ({$count} rijen)}}
waterfall.unread = Geen brug: deze rol leest niet elke rij van de groep volledig, dus de delen geven hier geen totaal.
waterfall.row = Rij
waterfall.gives = Draagt bij
waterfall.total = Totaal
finding.sum_not_closed = {{Geblokkeerd: de delen van {$value} tellen niet op tot het totaal.}}
finding.mixed_currency = {{Geblokkeerd: een som in meer dan één valuta ({$currencies}).}}

map.title = Kaart
map.cluster = .input {$count :number} .match $count one {{{$count} element}} * {{{$count} elementen}}
map.range = {{{$first} … {$last}}}
