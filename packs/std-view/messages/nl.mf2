# Het blad als betoog (docs/gui.md): de zones van een blad en de zes werkwoorden bij elke waarde.
zone.context = Context
zone.rests = Waar het op rust
zone.missing = Ontbreekt
zone.differs = Wijkt af
zone.twin = Toon als tabel
zone.verbs = Vragen bij deze waarde
claim.texts_missing = .input {$count :number} .match $count one {{{$count} tekst ontbreekt}} * {{{$count} teksten ontbreken}}
attention.none = Verder vraagt vandaag niets je aandacht.
verb.why = Waarom
verb.depends = Hangt hiervan af
verb.missing = Wat ontbreekt
verb.suppose = Wat als
verb.compare = Vergelijk
verb.propose = Stel voor

# De startpagina van een pack (RV-U04 op de kaart en de zes zones): de claim is één zin uit de aandachtskaarten.
home.eyebrow = {{Startpagina · {$pack}}}
home.claim = .input {$count :number} .match $count one {{Eén ding vraagt je aandacht: {$asks}.}} * {{{$count} dingen vragen je aandacht: {$asks}.}}
home.ask.red = .input {$count :number} .match $count one {{{$count} controle niet gehaald}} * {{{$count} controles niet gehaald}}
home.ask.warning = .input {$count :number} .match $count one {{{$count} controle met een waarschuwing}} * {{{$count} controles met een waarschuwing}}
home.ask.unavailable = .input {$count :number} .match $count one {{{$count} controle zonder uitkomst}} * {{{$count} controles zonder uitkomst}}
home.ask.proposals = .input {$count :number} .match $count one {{{$count} voorstel op deze publicatie}} * {{{$count} voorstellen op deze publicatie}}
home.ask.proposals_paged = voorstellen op meer dan één pagina
home.ask.texts = .input {$count :number} .match $count one {{{$count} tekst die het pack nog niet geeft}} * {{{$count} teksten die het pack nog niet geeft}}
home.calm = Alle controles zijn gehaald; verder vraagt niets je aandacht.
home.changed = Gewijzigd sinds je laatste bezoek

# De tabeltwin van de rijpagina: elke waarde van het element in één tabel.
row.twin.name = Kenmerk
row.twin.value = Waarde
row.twin.state = Toestand

# Your own publication form on the home of a pack (RV-V50): the schema id and the dataset hash in full, and each file.
home.form.title = Je gegevens in publicatievorm
home.form.schema = schema-id
home.form.dataset = datasethash
home.form.files = bestanden
