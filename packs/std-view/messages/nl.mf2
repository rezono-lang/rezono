@locale nl
---
# Labels van std-view in ICU MessageFormat 2.
status.valid = geldend
status.changed = gewijzigd
status.violated = geschonden
status.unknown = onbekend
status.not_applicable = niet van toepassing
status.absent = afwezig, gecontroleerd
# The value states a calculation step names (contracts/value.yaml) that are no status of their own.
status.known = bekend
status.invalid = ongeldig
# Shown in place of a text the pack does not give: never a message id (RV-U01).
text.missing = (tekst ontbreekt)
tone.positive = positief
tone.neutral = neutraal
tone.caution = let op
tone.negative = negatief
tone.unknown = onbekend
# De legenda van Rezono: wat er over een waarde bekend is, in elk pack en elk thema hetzelfde teken.
sign.origin_decision = herkomst: besluit
sign.origin_vendor = herkomst: leverancier of wet
sign.origin_design = herkomst: ontwerp
sign.origin_observation = herkomst: waarneming
sign.derived = afgeleid
sign.assumption = aanname
sign.drift = wijkt af van de referentie
sign.screened = niet zichtbaar voor je rol
sign.proposal = voorstel
sign.sealed = verzegeld
sign.supposed = verondersteld

lens.questions = Vragen
# The row page (RV-U05): what Rezono concludes first, then the facts, then the relations to other elements.
row.conclusions = Wat Rezono concludeert
row.conclusions_more = {{Er zijn er meer bij: {$relations}.}}
row.calculations = Berekend
calc.stop = ← hier stopt de berekening
row.facts = Feiten
row.relations = Relaties
# The lead of a row page (RV-U05): the conclusion, why it holds here, under which conditions, what the reader can do next.
lead.title = De conclusie in het kort
lead.conclusion = Geconcludeerd
lead.grounds = Waarom het hier geldt
lead.conditions = Zolang
lead.next = Wat u kunt doen
lead.value = {{{$element}: {$relation} {$value}}}
lead.row = {{{$relation}: {$row}}}
lead.absent = {{er geen {$relation} is ({$row})}}
lead.as_of = {{de feiten blijven zoals bekend op {$date}}}
lead.fill = {{vul {$value} in}}
lead.propose = stel een wijziging voor
lead.more = .input {$count :number} .match $count one {{en nog {$count} grond in het bewijs}} * {{en nog {$count} gronden in het bewijs}}

fold.current = GELDEND
fold.proposal = MET VOORSTEL

key.title = Verklaring van tekens
key.proof = gekozen bewijs
key.hatch = onbekend, nooit nul
key.unknown_end = verbinding met een onbekende kant
key.screened = afgeschermde stap
key.extension = verlenging
key.arrow = {{{$kind} → {$slot}}}
key.fact = feit (rechtop)
key.conclusion = conclusie (cursief)
key.selection = selectie
key.specimen = Aa
key.contour = {{hoogtelijn: elke lijn is een stap van 1/{$levels} van de hoogste top}}
key.coast = {{kust: één heuvel per {$member}}}
key.ring = {{ring: aandeel per status van de {$member}}}
key.image = {{afbeelding: {$slot} per {$kind}}}
key.cell = {{cel: hoeveel {$relation} er van de rij naar de kolom lopen; een cel van één opent het bewijs}}
key.cell_blank = lege cel: geen
key.cell_unknown = lege cel: onbekend, niet nul (de bron is open)
key.cell_size = oppervlak: aandeel van de grootste cel
key.band_rows = band: hoe dikker, hoe meer rijen
key.band_quantity = {{band: hoe dikker, hoe meer {$quantity}}}
key.band_gap = vereist, zonder besluit dat het dekt
key.open_derived = {{{$line}: een ontbrekende lijn kan onbekend zijn (de relatie leest een open bron)}}
key.open_stored = {{{$line}: een ontbrekende lijn is onbekend, niet geen}}
key.open_recorded = {{{$line}: {$recorded}; een ontbrekende lijn is onbekend, niet geen}}
key.boundary = {{grens: {$name}}}
key.bar = balk: gevuld is een feit, omlijnd een conclusie
key.lane = baan
key.scale = {{{$meaning}: hoogte naar (waarde − {$zero})^{$exponent}, met de exacte waarde erbij}}

sheet.index = Overzicht
sheet.kind = {{{$kind} {$id}}}
name.separator = {{ · }}
value.separator = {{, }}
value.reason = {{{$value} ({$reason})}}
# MOD18: een slot zonder rij in een gesloten wereld (W6); onbekend blijft `status.unknown`.
value.none = geen waarde
# Getaltypografie (docs/gui.md, Number typography): het echte minteken, het teken voor afgerond (exact heeft geen teken) en de breuk.
number.minus = −
number.rounded = ≈
number.fraction = {{{$numerator}⁄{$denominator}}}
sheet.answer = {{Antwoord over {$value}}}
sheet.impact = {{Impact van {$proposal}}}
sheet.proposed = {{Voorstel {$key}}}
sheet.packs = Packs

cartouche.title = Blad
cartouche.pack = Pack
cartouche.manifest = Publicatie
cartouche.knowledge_time = Kennistijd
cartouche.zoom = Schaal
# Op het laagste niveau toont het blad elk element; daarboven staat één vlak voor {$scale} eenheden.
cartouche.zoom_value = .input {$scale :number} .match $scale 1 {{elk element apart}} * {{1 : {$scale}}}
cartouche.manifest_value = {{{$id} · stand {$epoch}}}
cartouche.time_value = {{{$time} UTC}}

# Het antwoord op een uitlegvraag (std-explain): als tabel, per pagina; de kop is de zin van de vraag.
answer.distance = Stap
answer.value = Waarde
