# Het specimen (docs/gui.md, The specimen): elk teken van std-view in gebruik, op vaste, verzonnen gegevens.
specimen.title = Specimen van de beeldtaal
specimen.intro = Elk teken, elke toestand, elke lijn, elk getal en elke letter die Rezono gebruikt, in gebruik getoond. Dit blad is gemaakt uit std-view; de voorbeelden zijn verzonnen.
specimen.end = Een teken op een blad dat niet op dit blad staat, is een fout.
specimen.column.sign = Teken
specimen.column.meaning = Betekenis
specimen.column.use = In gebruik
specimen.column.token = In std-view
specimen.column.case = Geval
specimen.column.shown = Getoond als
specimen.legend = De legenda van Rezono
specimen.legend.note = Deze tekens betekenen in elk pack en elk thema hetzelfde. Wat we weten gaat voor het domein.
specimen.states = Toestanden
specimen.states.note = Elke toestand is drie dingen tegelijk: een toon, een teken en een woord. Valt er één weg, dan blijft de toestand leesbaar.
specimen.lines = Arcering en lijnen
specimen.lines.note = Een lijn of arcering op een blad heeft altijd een van deze betekenissen.
specimen.numbers = Getallen
specimen.numbers.note = Bedragen staan rechts uitgelijnd in tabelcijfers: cijfers van gelijke rang staan onder elkaar.
specimen.type = Letters en maten
specimen.type.note = De lettertypen, lettergroottes en lijndiktes van een blad, met hun naam in std-view.
specimen.lens = Vragen
specimen.verbs = Werkwoorden
specimen.verbs.note = Zes werkwoorden, bij elke waarde dezelfde, in vaste volgorde, elk met zijn toets. Een werkwoord dat voor een waarde niets kan zeggen, staat er niet.
specimen.lens.note = Eén teken per vorm van antwoord; elke vraag met die vorm krijgt het.
specimen.themes = Thema's
specimen.themes.note = Dezelfde tekens in elk thema van het palet. De tinten veranderen, de betekenis niet.
