answer.next = Volgende pagina
answer.close = Sluiten
answer.sheet = Als eigen blad
answer.compass = Kompas
answer.premises = Eerste premisse die niet geldt
answer.candidates = Wat het zou geven
answer.cut = Niet alles is getoond.
scale.samples = Gepubliceerde rasterwaarden, in rastervolgorde; tussenliggende waarden zijn niet berekend.
scale.value = Rasterwaarde
scale.status = Status
scale.difference = Gepubliceerd verschil
scale.green = Controles geslaagd
scale.warning = Waarschuwing
scale.red = Controles mislukt
scale.unavailable = Status niet beschikbaar
scale.not_computed = Nog niet berekend
scale.no_difference = Geen verschilgegevens beschikbaar
