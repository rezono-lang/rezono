# De effectkaart (docs/interaction.md, 3. Rimpeling): ringen naar afstand, sectoren per relatie, een teken per verandering.
sheet.effect = {{Effectkaart van {$what}}}
effect.of.proposal = {{voorstel {$proposal}}}
effect.of.variant = {{variant {$variant} van {$sweep}}}
effect.link = Effectkaart
effect.badge.added = +
effect.badge.removed = −
effect.badge.changed = Δ
effect.change.added = erbij
effect.change.removed = eraf
effect.change.changed = anders
effect.change.unchanged = gelijk gebleven
effect.change.outside = niet gezegd
effect.was = {{was {$was}}}
effect.key.added = erbij: de rij staat alleen in het voorstel
effect.key.removed = eraf: de rij staat alleen in de basis
effect.key.changed = anders: een andere waarde; de tabel zegt wat het was
effect.key.unchanged = oever: bereikt en gelijk gebleven; de rimpeling stopt hier
effect.key.outside = buiten zicht: deze rol leest dit niet volledig, dus wat er veranderde wordt niet gezegd
effect.key.ring = ring: het aantal bewijsstappen vanaf wat de delta zelf verandert; sector: de relatie
effect.key.cluster = getal: zoveel rijen van deze relatie op deze ring; de tabel noemt ze
effect.key.ahead = lichter: verder dan de getoonde ring
effect.cluster = .input {$count :number} .match $count one {{{$count} rij}} * {{{$count} rijen}}
effect.shore = .input {$count :number} .match $count one {{{$count} rij op de oever: bereikt en gelijk gebleven}} * {{{$count} rijen op de oever: bereikt en gelijk gebleven}}
effect.incomplete = {{Onvolledig: {$why}. Een veranderde rij zonder ring krijgt er geen.}}
effect.incomplete.depth = de rimpeling stopte op haar diepte
effect.incomplete.budget = de rimpeling stopte op de grens van de gate
effect.incomplete.not_read_in_full = deze rol leest een deel van het verschil niet volledig
effect.incomplete.paged = de kaart toont maar een deel van het antwoord: niet elke pagina ervan kwam binnen
effect.incomplete.unsaid = het antwoord zegt niet dat het volledig is
effect.none.question = Dit pakket stelt geen vraag die een effectkaart geeft.
effect.none.served = Er is hier geen effectkaart: het verschil is voor deze rol (nog) niet gepubliceerd, of het hoort niet bij de nieuwste publicatie.
effect.rings = Ringen
effect.ring.all = Alle ringen
effect.ring.upto = {{Tot ring {$ring}}}
