# Voorstellen (docs/lifecycle.md): een nieuwe waarde wordt een pull request, via de toegangspoort en CI.
enum.true = ja
enum.false = nee
propose.submit = Voorstellen
propose.title = {{Nieuwe waarde voor {$name}: {$value}}}
propose.title_stand = {{Stand {$proposal} voorgesteld: {$names}}}
propose.stand = .input {$count :number} .match $count one {{Deze stand voorstellen ({$count} waarde)}} * {{Deze stand voorstellen ({$count} waarden)}}
propose.state.pending = In behandeling: de CI-run maakt het voorstel.
propose.state.unknown = Onzeker: de Git-host gaf geen antwoord. Het voorstel kan al lopen.
propose.state.open = Open: het voorstel wacht op beoordeling.
propose.state.merged = Gemerged: de wijziging staat op main.
propose.state.closed = Gesloten zonder merge.
propose.state.absent = Geen voorstel bij deze sleutel.
propose.note.pending = De pull request verschijnt na de CI-run, meestal binnen een paar minuten. Deze pagina kijkt vanzelf opnieuw.
propose.note.impact = Impact volgt: CI rekent het voorstel door en publiceert het resultaat apart. Deze pagina kijkt vanzelf opnieuw.
propose.pull_request = {{Pull request {$id} op de Git-host}}
propose.impact = Impact tegen de laatste publicatie bekijken
# Fouten en weigeringen (AUD-W3): de tekst per status. De technische reden staat in het serverlog, niet op het scherm.
error.status.400 = Dit adres klopt niet: een van de parameters heeft een ongeldige vorm.
error.status.401 = Je bent niet aangemeld. Meld je aan bij de toegangspoort en probeer het opnieuw.
error.status.403 = Je rol heeft geen toegang tot deze viewer.
error.status.404 = Niet gevonden: deze pagina bestaat niet, of je rol leest haar niet.
error.status.500 = Er ging iets mis bij het maken van deze pagina. De oorzaak staat in het serverlog.
error.status.501 = Deze versie van het pack is hier niet per rij te lezen. Kies de nieuwste versie.
error.status.502 = De toegangspoort gaf geen antwoord. De oorzaak staat in het serverlog.

propose.error.right = Je rol mag hier geen voorstel doen.
propose.error.stale = Er is intussen een nieuwere publicatie. Laad de pagina opnieuw en stel opnieuw voor.
propose.error.size = Het voorstel is te groot.
propose.error.value = Deze waarde kan zo niet worden voorgesteld.
propose.error.host = De Git-host antwoordt nu niet. Probeer het later opnieuw.
propose.error.empty = Vul een waarde in.
propose.error.integer = Een geheel getal, zonder komma of punt.
propose.error.amount = Een bedrag zoals 1250,50: niet meer cijfers achter de komma dan de munt kent, zonder punten tussen de duizendtallen.
propose.error.boolean = Kies ja of nee.
propose.error.date = Een datum als jjjj-mm-dd.
propose.error.enum = Kies een van de waarden in de lijst.
propose.error.line = Eén regel tekst, zonder onzichtbare tekens.

