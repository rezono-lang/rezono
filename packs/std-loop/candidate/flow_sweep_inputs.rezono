rezono 0
pack std-loop

rules flow_sweep_inputs
  | .decl sweep_window(run: symbol, collector: symbol, window: symbol, start: number, stop: number, ref: symbol)
  | sweep_window(run, collector, window, start, stop, ref) :-
  |     flow_sweep_window__run(ref, run), flow_sweep_window__collector(ref, collector),
  |     flow_sweep_window__window(ref, window), flow_sweep_window__start(ref, start),
  |     flow_sweep_window__stop(ref, stop).
  | 
  | .decl expected_node(run: symbol, collector: symbol, window: symbol, node: symbol)
  | expected_node(run, collector, window, node) :-
  |     flow_expected_node__run(record, run), flow_expected_node__collector(record, collector),
  |     flow_expected_node__window(record, window), flow_expected_node__node(record, node).
  | 
  | .decl node_report(run: symbol, collector: symbol, window: symbol, node: symbol, first: number, last: number, gaps: number, lost: number)
  | node_report(run, collector, window, node, first, last, gaps, lost) :-
  |     flow_node_report__run(record, run), flow_node_report__collector(record, collector),
  |     flow_node_report__window(record, window), flow_node_report__node(record, node),
  |     flow_node_report__first(record, first), flow_node_report__last(record, last),
  |     flow_node_report__gaps(record, gaps), flow_node_report__lost(record, lost).
