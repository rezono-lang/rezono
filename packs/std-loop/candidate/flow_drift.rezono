rezono 0
pack std-loop

rules flow_drift
  | .decl flow_policy_count(run: symbol, collector: symbol, window: symbol, snapshots: number)
  | .decl flow_policy(run: symbol, collector: symbol, window: symbol, snapshot: symbol)
  | // A comparison cannot choose between conflicting snapshot bindings.
  | flow_policy_count(run, collector, window, snapshots) :-
  |     bound_policy(run, collector, window, _),
  |     snapshots = count : { bound_policy(run, collector, window, _) }.
  | flow_policy(run, collector, window, snapshot) :-
  |     bound_policy(run, collector, window, snapshot), flow_policy_count(run, collector, window, 1).
  | 
  | .decl flow_is_allowed(snapshot: symbol, source: symbol, destination: symbol, protocol: symbol, port: number)
  | flow_is_allowed(snapshot, source, destination, protocol, port) :-
  |     allowed_flow(snapshot, source, destination, protocol, port, _).
  | 
  | .decl scoped_flow_event(run: symbol, collector: symbol, window: symbol, sweep: symbol, source: symbol, destination: symbol, protocol: symbol, port: number, verdict: symbol, ref: symbol)
  | scoped_flow_event(run, collector, window, sweep, source, destination, protocol, port, verdict, ref) :-
  |     sweep_window(run, collector, window, start, stop, sweep),
  |     flow_event(run, collector, window, tick, source, destination, protocol, port, verdict, ref),
  |     start <= tick, tick < stop.
  | 
  | .decl flow_was_observed(run: symbol, collector: symbol, window: symbol, sweep: symbol, source: symbol, destination: symbol, protocol: symbol, port: number)
  | flow_was_observed(run, collector, window, sweep, source, destination, protocol, port) :-
  |     scoped_flow_event(run, collector, window, sweep, source, destination, protocol, port, _, _).
  | 
  | .decl flow_drift(run: symbol, collector: symbol, window: symbol, source: symbol, destination: symbol, protocol: symbol, port: number, class: symbol, status: symbol, policy_ref: symbol, observation_ref: symbol)
  | flow_drift(run, collector, window, source, destination, protocol, port, "matched", "valid", allowance, event) :-
  |     flow_policy(run, collector, window, snapshot),
  |     allowed_flow(snapshot, source, destination, protocol, port, allowance),
  |     scoped_flow_event(run, collector, window, _, source, destination, protocol, port, "forwarded", event).
  | flow_drift(run, collector, window, source, destination, protocol, port, "blocked", "violated", allowance, event) :-
  |     flow_policy(run, collector, window, snapshot),
  |     allowed_flow(snapshot, source, destination, protocol, port, allowance),
  |     scoped_flow_event(run, collector, window, _, source, destination, protocol, port, "dropped", event).
  | 
  | // An observation of a tuple outside a closed snapshot does not create an allowance.
  | flow_drift(run, collector, window, source, destination, protocol, port, "prevented", "absent", snapshot, event) :-
  |     flow_policy(run, collector, window, snapshot),
  |     scoped_flow_event(run, collector, window, _, source, destination, protocol, port, "dropped", event),
  |     !flow_is_allowed(snapshot, source, destination, protocol, port).
  | flow_drift(run, collector, window, source, destination, protocol, port, "excess", "violated", snapshot, event) :-
  |     flow_policy(run, collector, window, snapshot),
  |     scoped_flow_event(run, collector, window, _, source, destination, protocol, port, "forwarded", event),
  |     !flow_is_allowed(snapshot, source, destination, protocol, port).
  | 
  | // An idle allowance needs a complete sweep of this exact window.
  | flow_drift(run, collector, window, source, destination, protocol, port, "unseen", "unknown", allowance, sweep) :-
  |     flow_policy(run, collector, window, snapshot),
  |     allowed_flow(snapshot, source, destination, protocol, port, allowance),
  |     sweep_window(run, collector, window, _, _, sweep),
  |     complete_sweep(run, collector, window, sweep),
  |     !flow_was_observed(run, collector, window, sweep, source, destination, protocol, port).
  | 
  | .output flow_drift
