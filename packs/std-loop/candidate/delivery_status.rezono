rezono 0
pack std-loop

schema std_loop_delivery_status
  iri "https://rezono.org/std-loop/delivery-status"
  import "linkml:types"
  default range Text
  description "A recorded reading supporting the status of one delivery step."
  annotation layer = "facts"

kind LoopStatusObservation world closed
  tenant: Text
  delivery: Text
  step: Text
  run: Text
  relation: Text
  reason: Text
  `at`: Text?
    description "Original event time when known; omitted when unknown."
  event_time: Int?
    description "Order of the original event instant when known; omitted when unknown."

rules delivery_status
  | .decl status_observation_state(event: symbol, state: symbol)
  | .decl status_observation_dated(event: symbol)
  | .decl status_reading(tenant: symbol, delivery: symbol, step: symbol, run: symbol, time: number, event: symbol, at: symbol, state: symbol, reason: symbol)
  | .decl status_reading_time_unknown(tenant: symbol, delivery: symbol, step: symbol, run: symbol, event: symbol, state: symbol, reason: symbol)
  | .decl status_latest(tenant: symbol, delivery: symbol, step: symbol, run: symbol, time: number)
  | .decl status_has_dated(tenant: symbol, delivery: symbol, step: symbol, run: symbol)
  | .decl status_has_undated(tenant: symbol, delivery: symbol, step: symbol, run: symbol)
  | .decl status_time_state(tenant: symbol, delivery: symbol, step: symbol, run: symbol, state: symbol)
  | .decl status_contender(tenant: symbol, delivery: symbol, step: symbol, run: symbol, state: symbol, reason: symbol)
  | .decl status_disagreement(tenant: symbol, delivery: symbol, step: symbol, run: symbol, reason: symbol)
  | .decl status_conflict(tenant: symbol, delivery: symbol, step: symbol, run: symbol)
  | .decl current_delivery_status(tenant: symbol, delivery: symbol, step: symbol, run: symbol, state: symbol, reason: symbol)
  | 
  | status_observation_state(event, "success") :- loop_status_observation__relation(event, "done").
  | status_observation_state(event, "failure") :- loop_status_observation__relation(event, "stuck").
  | status_observation_state(event, "pending") :- loop_status_observation__relation(event, "planned").
  | status_observation_state(event, "pending") :- loop_status_observation__relation(event, "waiting").
  | 
  | status_observation_dated(event) :-
  |     loop_status_observation__event_time(event, _),
  |     loop_status_observation__at(event, at),
  |     at != "".
  | 
  | status_reading(tenant, delivery, step, run, time, event, at, state, reason) :-
  |     loop_status_observation__tenant(event, tenant), loop_status_observation__delivery(event, delivery),
  |     loop_status_observation__step(event, step), loop_status_observation__run(event, run),
  |     loop_status_observation__event_time(event, time), loop_status_observation__at(event, at),
  |     at != "",
  |     status_observation_state(event, state), loop_status_observation__reason(event, reason).
  | 
  | status_reading_time_unknown(tenant, delivery, step, run, event, state, reason) :-
  |     loop_status_observation__tenant(event, tenant), loop_status_observation__delivery(event, delivery),
  |     loop_status_observation__step(event, step), loop_status_observation__run(event, run),
  |     status_observation_state(event, state), loop_status_observation__reason(event, reason),
  |     !status_observation_dated(event).
  | 
  | status_latest(tenant, delivery, step, run, latest) :-
  |     status_reading(tenant, delivery, step, run, _, _, _, _, _),
  |     latest = max time : { status_reading(tenant, delivery, step, run, time, _, _, _, _) }.
  | 
  | status_has_dated(tenant, delivery, step, run) :-
  |     status_latest(tenant, delivery, step, run, _).
  | 
  | status_has_undated(tenant, delivery, step, run) :-
  |     status_reading_time_unknown(tenant, delivery, step, run, _, _, _).
  | 
  | status_time_state(tenant, delivery, step, run, "known") :-
  |     status_has_dated(tenant, delivery, step, run),
  |     !status_has_undated(tenant, delivery, step, run).
  | 
  | status_time_state(tenant, delivery, step, run, "unknown") :-
  |     status_has_undated(tenant, delivery, step, run).
  | 
  | status_contender(tenant, delivery, step, run, state, reason) :-
  |     status_latest(tenant, delivery, step, run, time),
  |     status_reading(tenant, delivery, step, run, time, _, _, state, reason).
  | 
  | // A reading whose event instant is unknown can still disagree with the latest comparable reading
  | // or with another reading whose event instant is unknown.
  | status_contender(tenant, delivery, step, run, state, reason) :-
  |     status_reading_time_unknown(tenant, delivery, step, run, _, state, reason).
  | 
  | status_disagreement(tenant, delivery, step, run, reason) :-
  |     status_contender(tenant, delivery, step, run, state, reason),
  |     status_contender(tenant, delivery, step, run, other, _), state != other.
  | 
  | status_conflict(tenant, delivery, step, run) :- status_disagreement(tenant, delivery, step, run, _).
  | 
  | current_delivery_status(tenant, delivery, step, run, state, reason) :-
  |     status_latest(tenant, delivery, step, run, time),
  |     status_reading(tenant, delivery, step, run, time, _, _, state, reason),
  |     !status_conflict(tenant, delivery, step, run).
  | 
  | current_delivery_status(tenant, delivery, step, run, state, reason) :-
  |     status_reading_time_unknown(tenant, delivery, step, run, _, state, reason),
  |     !status_has_dated(tenant, delivery, step, run),
  |     !status_conflict(tenant, delivery, step, run).
  | 
  | current_delivery_status(tenant, delivery, step, run, "pending", reason) :-
  |     status_disagreement(tenant, delivery, step, run, reason).
