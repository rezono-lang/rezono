rezono 0
pack std-loop

schema std_loop_effect
  iri "https://rezono.org/std-loop/effect"
  import "linkml:types"
  default range Text
  description "Planned effects, journaled attempts, target readbacks and effect journal states (decisions/loop-engine-epoch.md)."
  annotation layer = "facts"

enum LoopEffectState world closed = planned | applying | unknown | applied | failed | cleaned
  description "The journal state for a single effect plan, shared across runs with contracts/effect.yaml."
  value planned
    description "The exact plan is retained and the attempt is available to claim."
  value applying
    description "The sole attempt is durably claimed before sending the request."
  value unknown
    description "The attempt is consumed and its outcome is uncertain. Reconcile only."
  value applied
    description "Matching effect evidence has been confirmed."
  value failed
    description "The consumed attempt was definitively rejected. An uncertain response is not failure."
  value cleaned
    description "Cleanup was confirmed. The original attempt remains consumed."

enum LoopEffectAttemptOutcome world closed = claimed | sent | refused | unknown
  description "The recorded outcome of one journaled effect attempt."
  value claimed
    description "The claim was made and no answer was recorded."
  value sent
    description "The request was sent and accepted."
  value refused
    description "The attempt was definitively refused before applying."
  value unknown
    description "The outcome of the sent attempt is uncertain."

enum LoopEffectReadbackState world closed = expected | before | other
  description "What a complete target readback observed after an effect attempt."
  value expected
    description "The target shows what the plan produces."
  value before
    description "The target still shows the state before the effect."
  value other
    description "The target shows another state that neither matches the plan nor the prior state."

kind LoopEffectPlan world closed
  description "The exact planned input of one effect. Its id is the idempotency key (the plan hash)."
  run: Text
  step: LoopStep
  reason: Text

kind LoopEffectAttempt world closed
  description "One journaled attempt for a planned effect, as the effect adapter recorded it."
  run: Text
  plan: LoopEffectPlan
  sent_at: Int
  outcome: LoopEffectAttemptOutcome
  source: Text

kind LoopEffectReadback world closed
  description "A complete read of an effect target after an attempt, settling only with a receipt of its own run and tick."
  run: Text
  plan: LoopEffectPlan
  observed_at: Int
  state: LoopEffectReadbackState
  receipt: LoopSweepReceipt?
  source: Text

rules effect
  | // Shared effect lifecycle and once-per-plan settling rules (decisions/loop-engine-epoch.md, section 5).
  | // Permission for a planned effect is supplied by the importing pack; a declaration alone denotes the empty set.
  | // @extend
  | .decl effect_permitted(run: symbol, step: symbol, plan: symbol, reason: symbol)
  | 
  | .decl effect_attempt(run: symbol, plan: symbol, sent_at: number, outcome: symbol)
  | .decl effect_attempted(run: symbol, plan: symbol)
  | .decl effect_latest_attempt(run: symbol, plan: symbol, sent_at: number)
  | .decl effect_effective_attempt(run: symbol, plan: symbol, sent_at: number)
  | .decl effect_has_effective_attempt(run: symbol, plan: symbol)
  | .decl effect_submitted_attempt(run: symbol, plan: symbol)
  | .decl effect_planned(run: symbol, step: symbol, plan: symbol, reason: symbol)
  | .decl effect_readback(run: symbol, plan: symbol, tick: number, state: symbol)
  | .decl effect_readback_expected(run: symbol, plan: symbol, tick: number)
  | .decl effect_readback_before(run: symbol, plan: symbol, tick: number)
  | .decl effect_readback_other(run: symbol, plan: symbol, tick: number)
  | .decl effect_settling_readback(run: symbol, plan: symbol, sent_at: number, tick: number, outcome: symbol)
  | .decl effect_settled_earlier(run: symbol, plan: symbol, sent_at: number, tick: number)
  | .decl effect_first_settling(run: symbol, plan: symbol, sent_at: number, outcome: symbol)
  | .decl effect_discarded(run: symbol, plan: symbol, reason: symbol)
  | .decl effect_discarded_at(run: symbol, plan: symbol)
  | .decl effect_confirmed(run: symbol, plan: symbol, reason: symbol)
  | .decl effect_settled(run: symbol, plan: symbol)
  | .decl effect_still_before(run: symbol, plan: symbol)
  | .decl effect_pending(run: symbol, plan: symbol, reason: symbol)
  | .decl effect_applying(run: symbol, plan: symbol)
  | .decl effect_state(run: symbol, plan: symbol, state: symbol, reason: symbol)
  | 
  | // Any journaled attempt of a plan in a run with a source consumes its key, whatever its outcome.
  | effect_attempt(run, plan, sent_at, outcome) :-
  |     loop_effect_attempt__run(attempt, run),
  |     loop_effect_attempt__plan(attempt, plan),
  |     loop_effect_attempt__sent_at(attempt, sent_at),
  |     loop_effect_attempt__outcome(attempt, outcome),
  |     loop_effect_attempt__source(attempt, source),
  |     source != "".
  | 
  | effect_attempted(run, plan) :-
  |     effect_attempt(run, plan, _, _).
  | 
  | // Only readbacks strictly after the latest recorded attempt of a plan can settle it.
  | effect_latest_attempt(run, plan, latest) :-
  |     effect_attempted(run, plan),
  |     latest = max sent_at : { effect_attempt(run, plan, sent_at, _) }.
  | 
  | // A claimed, sent or unknown attempt may have changed the target, so only a later receipted readback settles it.
  | effect_effective_attempt(run, plan, sent_at) :- effect_attempt(run, plan, sent_at, "claimed").
  | effect_effective_attempt(run, plan, sent_at) :- effect_attempt(run, plan, sent_at, "sent").
  | effect_effective_attempt(run, plan, sent_at) :- effect_attempt(run, plan, sent_at, "unknown").
  | 
  | effect_has_effective_attempt(run, plan) :- effect_effective_attempt(run, plan, _).
  | 
  | effect_submitted_attempt(run, plan) :- effect_attempt(run, plan, _, "sent").
  | effect_submitted_attempt(run, plan) :- effect_attempt(run, plan, _, "unknown").
  | 
  | // Only an unblocked step's permitted plan without an attempt may go out through the effect port.
  | effect_planned(run, step, plan, reason) :-
  |     unblocked(run, step, _),
  |     effect_permitted(run, step, plan, reason),
  |     !effect_attempted(run, plan).
  | 
  | // A target readback counts only with a source and a sweep receipt of its own run at its own tick.
  | effect_readback(run, plan, tick, state) :-
  |     loop_effect_readback__run(read, run),
  |     loop_effect_readback__plan(read, plan),
  |     loop_effect_readback__observed_at(read, tick),
  |     loop_effect_readback__state(read, state),
  |     loop_effect_readback__source(read, source),
  |     source != "",
  |     loop_effect_readback__receipt(read, receipt),
  |     receipt != "",
  |     loop_sweep_receipt__run(receipt, run),
  |     loop_sweep_receipt__event_time(receipt, tick).
  | 
  | effect_readback_expected(run, plan, tick) :- effect_readback(run, plan, tick, "expected").
  | effect_readback_before(run, plan, tick) :- effect_readback(run, plan, tick, "before").
  | effect_readback_other(run, plan, tick) :- effect_readback(run, plan, tick, "other").
  | 
  | // A settling readback is a receipted readback of the same run strictly after the latest attempt
  | // with an unambiguous expected or other state.
  | effect_settling_readback(run, plan, sent_at, tick, "confirmed") :-
  |     effect_has_effective_attempt(run, plan),
  |     effect_latest_attempt(run, plan, sent_at),
  |     effect_readback_expected(run, plan, tick),
  |     tick > sent_at,
  |     !effect_readback_before(run, plan, tick),
  |     !effect_readback_other(run, plan, tick).
  | effect_settling_readback(run, plan, sent_at, tick, "discarded") :-
  |     effect_has_effective_attempt(run, plan),
  |     effect_latest_attempt(run, plan, sent_at),
  |     effect_readback_other(run, plan, tick),
  |     tick > sent_at,
  |     !effect_readback_expected(run, plan, tick),
  |     !effect_readback_before(run, plan, tick).
  | 
  | effect_settled_earlier(run, plan, sent_at, tick) :-
  |     effect_settling_readback(run, plan, sent_at, tick, _),
  |     effect_settling_readback(run, plan, sent_at, earlier, _),
  |     earlier < tick.
  | 
  | // The first settling readback after the latest attempt decides.
  | effect_first_settling(run, plan, sent_at, outcome) :-
  |     effect_settling_readback(run, plan, sent_at, tick, outcome),
  |     !effect_settled_earlier(run, plan, sent_at, tick).
  | 
  | // Discard when the first settling readback after the latest attempt shows another state,
  | // or when only a refused attempt exists.
  | effect_discarded(run, plan, "readback-other") :-
  |     effect_latest_attempt(run, plan, sent_at),
  |     effect_first_settling(run, plan, sent_at, "discarded").
  | effect_discarded(run, plan, "attempt-refused") :-
  |     effect_attempt(run, plan, _, "refused"),
  |     !effect_has_effective_attempt(run, plan).
  | effect_discarded_at(run, plan) :-
  |     effect_discarded(run, plan, _).
  | 
  | // Confirm when the first settling readback after the latest attempt shows the expected state
  | // and nothing discarded the plan.
  | effect_confirmed(run, plan, "expected-after-attempt") :-
  |     effect_latest_attempt(run, plan, sent_at),
  |     effect_first_settling(run, plan, sent_at, "confirmed"),
  |     !effect_discarded_at(run, plan).
  | 
  | effect_settled(run, plan) :- effect_confirmed(run, plan, _).
  | effect_settled(run, plan) :- effect_discarded(run, plan, _).
  | 
  | effect_still_before(run, plan) :-
  |     effect_has_effective_attempt(run, plan),
  |     effect_latest_attempt(run, plan, sent_at),
  |     effect_readback_before(run, plan, tick),
  |     tick > sent_at.
  | 
  | // An effective attempt without a settling readback remains pending until reconciled.
  | effect_pending(run, plan, "still-before") :-
  |     effect_has_effective_attempt(run, plan),
  |     !effect_settled(run, plan),
  |     effect_still_before(run, plan).
  | effect_pending(run, plan, "readback-missing") :-
  |     effect_has_effective_attempt(run, plan),
  |     !effect_settled(run, plan),
  |     !effect_still_before(run, plan).
  | 
  | // A claimed attempt stays in applying until a submission outcome or settling readback is recorded.
  | effect_applying(run, plan) :-
  |     effect_attempt(run, plan, _, "claimed"),
  |     !effect_submitted_attempt(run, plan),
  |     !effect_settled(run, plan).
  | 
  | // Derived journal states matching contracts/effect.yaml EffectState (cleaned is supplied by a later cleanup plan).
  | effect_state(run, plan, "planned", reason) :-
  |     effect_planned(run, _, plan, reason).
  | effect_state(run, plan, "applying", reason) :-
  |     effect_pending(run, plan, reason),
  |     effect_applying(run, plan).
  | effect_state(run, plan, "unknown", reason) :-
  |     effect_pending(run, plan, reason),
  |     !effect_applying(run, plan).
  | effect_state(run, plan, "applied", reason) :-
  |     effect_confirmed(run, plan, reason).
  | effect_state(run, plan, "failed", reason) :-
  |     effect_discarded(run, plan, reason).
  | 
  | .output effect_planned
  | .output effect_attempted
  | .output effect_pending
  | .output effect_confirmed
  | .output effect_discarded
  | .output effect_state
