{"format":"rezono.module/2","module":{"annotations":{"layer":"facts"},"decls":[{"derived":[],"description":"A step in the plan, with precedence inherited from std-order.","kind":"LoopStep","parent":"Ordered","slots":[],"world":"closed"},{"derived":[],"description":"The run selected for evaluation. Historical events keep their own run identifiers.","kind":"LoopActiveRun","slots":[],"world":"closed"},{"derived":[],"description":"A source declaration naming the token that confirms completion of a step.","kind":"LoopCompletion","slots":[{"slot":"run","type":"Text"},{"slot":"step","type":"LoopStep"},{"slot":"token","type":"Text"},{"slot":"reason","type":"Text"}],"world":"closed"},{"derived":[],"description":"The expected comparison value identified by its token.","kind":"LoopExpectation","slots":[{"slot":"value","type":"Text"}],"world":"closed"},{"derived":[],"description":"A recorded event with its normalized value state and separate evidence reference.","kind":"LoopObservation","slots":[{"slot":"run","type":"Text"},{"slot":"token","type":"Text"},{"slot":"event_time","type":"Int"},{"slot":"state","type":"Text"},{"slot":"value","type":"Text"},{"slot":"reason","type":"Text"},{"card":"?","description":"The collector scope in which the lookup was made.","slot":"scope","type":"Text"},{"card":"?","description":"The observation window in that scope.","slot":"sweep","type":"Text"}],"world":"closed"},{"derived":[],"description":"A prerequisite token explicitly required by a step in a run.","kind":"LoopRequirement","slots":[{"slot":"run","type":"Text"},{"slot":"step","type":"LoopStep"},{"slot":"token","type":"Text"},{"slot":"reason","type":"Text"}],"world":"closed"},{"derived":[],"description":"A recorded terminal refusal to perform a step in a run.","kind":"LoopRefusal","slots":[{"slot":"run","type":"Text"},{"slot":"step","type":"LoopStep"},{"slot":"reason","type":"Text"}],"world":"closed"},{"lines":["// Join the admitted slots of a single record before projecting the fragment i