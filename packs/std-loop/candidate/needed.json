{"format":"rezono.module/2","module":{"decls":[{"lines":[".decl needed(run: symbol, step: symbol, token: symbol, reason: symbol)","","needed(run, step, token, reason) :-","    requirement(run, step, token, reason).","","// The successor requires the predecessor's completion token in the same run.","needed(run, step, token, reason) :-","    before(predecessor, step),","    completion(run, predecessor, token, reason)."],"rules":"needed"}],"pack":"std-loop","rezono":"0","use":[]},"spans":[{"at":"/decls/0","end":"36","line":"4","start":"30"}]}