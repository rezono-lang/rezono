rezono 0
pack std-loop

rules ready
  | // Block only within the same run, regardless of the blocker witness.
  | .decl not_ready(run: symbol, step: symbol)
  | not_ready(r, s) :- waiting(r, s, _, _).
  | not_ready(r, s) :- done(r, s, _).
  | 
  | // Only members of the admitted verified round for the current run and cut enter ready.
  | .decl ready(run: symbol, step: symbol, reason: symbol)
  | ready(r, s, round) :-
  |     current_verified_round(round, r, _, b),
  |     verified_round_member(round, s),
  |     !loop_batch_undecided(b),
  |     eligible(r, s, _),
  |     !not_ready(r, s).
  | 
  | .output ready
