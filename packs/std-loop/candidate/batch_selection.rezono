rezono 0
pack std-loop

schema std_loop_batch_selection
  iri "https://rezono.org/std-loop/batch-selection"
  import "linkml:types"
  default range Text
  description "The width, member order and independent verdicts for one finite batch comparison."
  annotation layer = "facts"

enum LoopBatchVerdict world closed = proved | refuted | unknown

kind LoopBatchDomain world closed
  width: Int
    minimum 1

kind LoopBatchCandidate world closed
  domain: LoopBatchDomain
  size: Int
    minimum 0
  verdict: LoopBatchVerdict?

kind LoopBatchStep world closed
  priority: Int

kind LoopBatchVisible world closed
  batch: LoopBatchCandidate
  subset: LoopBatchCandidate

kind LoopBatchWrite world closed
  step: LoopBatchStep
  target: Text

kind LoopBatchMember world closed
  batch: LoopBatchCandidate
  step: LoopBatchStep
  position: Int
    minimum 0

rules batch_selection
  | // A candidate supplies the entire visible subset domain, including itself and the empty subset.
  | .decl loop_batch_unproved(batch: symbol)
  | loop_batch_unproved(b) :-
  |     loop_batch_visible__batch(row, b), loop_batch_visible__subset(row, v),
  |     !loop_batch_candidate__verdict(v, "proved").
  | 
  | .decl loop_batch_write_conflict(batch: symbol)
  | loop_batch_write_conflict(b) :-
  |     loop_batch_member__batch(x, b), loop_batch_member__batch(y, b),
  |     loop_batch_member__position(x, i), loop_batch_member__position(y, j), i < j,
  |     loop_batch_member__step(x, s), loop_batch_member__step(y, t),
  |     loop_batch_write__step(a, s), loop_batch_write__step(z, t),
  |     loop_batch_write__target(a, slot), loop_batch_write__target(z, slot).
  | 
  | .decl loop_certified_batch(batch: symbol, domain: symbol, size: number)
  | loop_certified_batch(b, d, n) :-
  |     loop_batch_candidate__domain(b, d), loop_batch_candidate__size(b, n),
  |     loop_batch_domain__width(d, w), n > 0, n <= w,
  |     loop_batch_visible__batch(full, b), loop_batch_visible__subset(full, b),
  |     loop_batch_visible__batch(base, b), loop_batch_visible__subset(base, e),
  |     loop_batch_candidate__domain(e, d), loop_batch_candidate__size(e, 0),
  |     !loop_batch_unproved(b), !loop_batch_write_conflict(b).
  | 
  | // The round verifier replayed the choice, so an admitted batch of the current cut is certified and selected.
  | // Its domain column is the round digest, which a witness cites.
  | loop_certified_batch(b, round, n) :-
  |     current_verified_round(round, _, _, b),
  |     n = count : { verified_round_member(round, _) }.
  | 
  | .decl loop_batch_priority(batch: symbol, position: number, priority: number)
  | loop_batch_priority(b, i, p) :-
  |     loop_batch_member__batch(m, b), loop_batch_member__position(m, i),
  |     loop_batch_member__step(m, s), loop_batch_step__priority(s, p).
  | 
  | .decl loop_batch_difference(first: symbol, second: symbol, position: number)
  | loop_batch_difference(a, b, i) :-
  |     loop_certified_batch(a, d, n), loop_certified_batch(b, d, n),
  |     loop_batch_priority(a, i, p), loop_batch_priority(b, i, q), p != q.
  | 
  | .decl loop_batch_earlier_difference(first: symbol, second: symbol, position: number)
  | loop_batch_earlier_difference(a, b, i) :-
  |     loop_batch_difference(a, b, i), loop_batch_difference(a, b, j), j < i.
  | 
  | .decl loop_batch_preceded(batch: symbol)
  | loop_batch_preceded(b) :-
  |     loop_certified_batch(a, d, m), loop_certified_batch(b, d, n), m > n.
  | loop_batch_preceded(b) :-
  |     loop_batch_difference(a, b, i), !loop_batch_earlier_difference(a, b, i),
  |     loop_batch_priority(a, i, p), loop_batch_priority(b, i, q), p < q.
  | 
  | // The round verifier replays the choice for each claim on its own, and the batch is the label its claim gives.
  | // Two admitted rounds of one run and cut that name different batches leave the choice undecided, so neither is
  | // selected: a round's batch is certified in the domain of its own round, where nothing else can precede it.
  | .decl loop_batch_undecided(batch: symbol)
  | loop_batch_undecided(b) :-
  |     current_verified_round(_, run, cut, b), current_verified_round(_, run, cut, c), b != c.
  | 
  | // A verified round's batch is certified above, so this one rule also selects it.
  | .decl loop_selected_batch(batch: symbol)
  | loop_selected_batch(b) :- loop_certified_batch(b, _, _), !loop_batch_preceded(b), !loop_batch_undecided(b).
  | 
  | .output loop_certified_batch
  | .output loop_selected_batch
