{"format":"rezono.module/2","module":{"annotations":{"layer":"facts"},"decls":[{"enum":"LoopBatchVerdict","values":["proved","refuted","unknown"],"world":"closed"},{"derived":[],"kind":"LoopBatchDomain","slots":[{"constraints":[{"minimum":"1"}],"slot":"width","type":"Int"}],"world":"closed"},{"derived":[],"kind":"LoopBatchCandidate","slots":[{"slot":"domain","type":"LoopBatchDomain"},{"constraints":[{"minimum":"0"}],"slot":"size","type":"Int"},{"card":"?","slot":"verdict","type":"LoopBatchVerdict"}],"world":"closed"},{"derived":[],"kind":"LoopBatchStep","slots":[{"slot":"priority","type":"Int"}],"world":"closed"},{"derived":[],"kind":"LoopBatchVisible","slots":[{"slot":"batch","type":"LoopBatchCandidate"},{"slot":"subset","type":"LoopBatchCandidate"}],"world":"closed"},{"derived":[],"kind":"LoopBatchWrite","slots":[{"slot":"step","type":"LoopBatchStep"},{"slot":"target","type":"Text"}],"world":"closed"},{"derived":[],"kind":"LoopBatchMember","slots":[{"slot":"batch","type":"LoopBatchCandidate"},{"slot":"step","type":"LoopBatchStep"},{"constraints":[{"minimum":"0"}],"slot":"position","type":"Int"}],"world":"closed"},{"lines":["// The round verifier replayed the choice, so an admitted batch of the current cut is certified and selected.","// Its domain column is the round digest, which a witness cites.",".decl loop_certified_batch(batch: symbol, domain: symbol, size: number)","loop_certified_batch(b, round, n) :-","    current_verified_round(round, _, _, b),","    n = count : { verified_round_member(round, _) }.","","// The round verifier replays the choice for each claim on its own, and the batch is the label its claim gives.","// Two distinct admitted rounds of one run and cut leave the choice undecided for that run and cut, even when","// they share a batch label, without affecting any other run or cut.",".decl loop_batch_undecided(run: symbol, cut: symbol)","loop_batch_undecided(run, cut) :-","    current_verified_round(r1, run, cut, _), current_verified_round(r2, run, cut, _), r1 != r2.","","// A verified round's batch is certified above, so this rule selects it unless another admitted round of the","// same run and cut disagrees.",".decl loop_selected_batch(batch: symbol)","loop_selected_batch(b) :-","    current_verified_round(round, run, cut, b),","    loop_certified_batch(b, round, _),","    !loop_batch_undecided(run, cut).","",".output loop_certified_batch",".output loop_selected_batch"],"rules":"batch_selection"}],"defaultRange":"Text","description":"The width, member order and independent verdicts for one finite batch comparison.","imports":["linkml:types"],"iri":"https://rezono.org/std-loop/batch-selection","pack":"std-loop","rezono":"0","schema":"std_loop_batch_selection","use":[]},"spans":[{"at":"","end":"55","line":"4","start":"31"},{"at":"/decls/0","end":"302","line":"11","start":"286"},{"at":"/decls/1","end":"366","line":"13","start":"351"},{"at":"/decls/1/slots/0","end":"387","line":"14","start":"382"},{"at":"/decls/1/slots/0/constraints/0","end":"404","line":"15","start":"397"},{"at":"/decls/2","end":"431","line":"17","start":"413"},{"at":"/decls/2/slots/0","end":"453","line":"18","start":"447"},{"at":"/decls/2/slots/1","end":"477","line":"19","start":"473"},{"at":"/decls/2/slots/1/constraints/0","end":"494","line":"20","start":"487"},{"at":"/decls/2/slots/2","end":"506","line":"21","start":"499"},{"at":"/decls/3","end":"545","line":"23","start":"532"},{"at":"/decls/3/slots/0","end":"569","line":"24","start":"561"},{"at":"/decls/4","end":"597","line":"26","start":"581"},{"at":"/decls/4/slots/0","end":"618","line":"27","start":"613"},{"at":"/decls/4/slots/1","end":"647","line":"28","start":"641"},{"at":"/decls/5","end":"688","line":"30","start":"674"},{"at":"/decls/5/slots/0","end":"708","line":"31","start":"704"},{"at":"/decls/5/slots/1","end":"732","line":"32","start":"726"},{"at":"/decls/6","end":"760","line":"34","start":"745"},{"at":"/decls/6/slots/0","end":"781","line":"35","start":"776"},{"at":"/decls/6/