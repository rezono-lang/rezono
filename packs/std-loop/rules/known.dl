.decl known_latest(run: symbol, token: symbol, event_time: number)
.decl known_conflict(run: symbol, token: symbol, event_time: number)
.decl known(run: symbol, token: symbol, reason: symbol)

known_latest(run, token, latest) :-
    active(run), observed(run, token, _, _, _, _, _),
    latest = max time : { observed(run, token, time, _, _, _, _) }.

// Distinct witnesses coexist when they agree on the known state and value.
known_conflict(run, token, time) :-
    known_latest(run, token, time),
    observed(run, token, time, _, state, _, _), state != "known".
known_conflict(run, token, time) :-
    known_latest(run, token, time),
    observed(run, token, time, _, "known", value, _),
    observed(run, token, time, _, "known", other, _), value != other.

known(run, token, reason) :-
    known_latest(run, token, time), expectation(token, value),
    observed(run, token, time, _, "known", value, reason),
    !known_conflict(run, token, time).
