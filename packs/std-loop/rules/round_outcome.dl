// A difference declared before execution excuses its drift only for the exact observed value.
.decl expected_drift(run: symbol, token: symbol, observed_ref: symbol)
expected_drift(run, token, observed_ref) :-
    drift(run, token, _, observed_ref), current(run, token, _, value, observed_ref),
    loop_expected_difference__run(declaration, run), loop_expected_difference__token(declaration, token),
    loop_expected_difference__observed(declaration, value).

// A stuck step or an undeclared or different discrepancy blocks completion of the run.
.decl round_failed(run: symbol)
round_failed(run) :- active(run), stuck(run, _, _).
round_failed(run) :- active(run), drift(run, token, _, observed_ref), !expected_drift(run, token, observed_ref).

.decl round_unfinished(run: symbol)
round_unfinished(run) :- declared(run, step, _), !waiting_done(run, step).
round_unfinished(run) :- unproduced_goal(run, _, _).

// The terminal state of the selected run: failure, success, or pending while work remains.
.decl round_outcome(run: symbol, state: symbol)
round_outcome(run, "failure") :- round_failed(run).
round_outcome(run, "success") :- active(run), !round_failed(run), !round_unfinished(run).
round_outcome(run, "pending") :- active(run), !round_failed(run), round_unfinished(run).

.output round_outcome
