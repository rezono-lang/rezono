.decl stuck(run: symbol, step: symbol, reason: symbol)

// A cycle blocks each declared step it contains.
stuck(run, step, reason) :-
    declared(run, step, reason),
    order_cycle(step).

// Cite terminal refusal evidence for the same declared step and run.
stuck(run, step, reason) :-
    declared(run, step, _),
    refusal(run, step, reason).
