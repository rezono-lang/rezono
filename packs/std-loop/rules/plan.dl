// The plan's step identity is its declaration witness in each selected run.
.decl declared(run: symbol, step: symbol, reason: symbol)
declared(run, step, step) :- active(run), loop_step(step).

.decl requirement(run: symbol, step: symbol, token: symbol, reason: symbol)
requirement(run, step, token, reason) :-
    loop_requirement__run(record, run), loop_requirement__step(record, step),
    loop_requirement__token(record, token), loop_requirement__reason(record, reason).

.decl refusal(run: symbol, step: symbol, reason: symbol)
refusal(run, step, reason) :-
    loop_refusal__run(record, run), loop_refusal__step(record, step),
    loop_refusal__reason(record, reason).

.decl blocked_step(run: symbol, step: symbol)
blocked_step(run, step) :- structural_stuck(run, step, _).

.decl eligible(run: symbol, step: symbol, reason: symbol)
eligible(run, step, reason) :- declared(run, step, reason), !blocked_step(run, step).
