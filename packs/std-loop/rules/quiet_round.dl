// A consumed sweep of an active run, also when it returned no new values.
.decl dated_sweep(run: symbol, sweep: symbol, event_time: number)
dated_sweep(run, sweep, time) :-
    active(run), loop_sweep__run(sweep, run), loop_sweep__event_time(sweep, time).

// The current sweep of a run is its latest dated sweep. A sweep of another run never counts.
.decl latest_sweep(run: symbol, event_time: number)
latest_sweep(run, latest) :-
    active(run), dated_sweep(run, _, _),
    latest = max time : { dated_sweep(run, _, time) }.

.decl current_sweep(run: symbol, sweep: symbol, event_time: number)
current_sweep(run, sweep, time) :- latest_sweep(run, time), dated_sweep(run, sweep, time).

.decl sweep_flag(sweep: symbol, complete: boolean)
sweep_flag(sweep, complete) :- loop_sweep(sweep), loop_sweep__complete(sweep, complete).

// Only an explicitly complete current sweep can close the round; false and a missing flag cannot.
.decl complete_current_sweep(run: symbol, sweep: symbol)
complete_current_sweep(run, sweep) :-
    current_sweep(run, sweep, _), sweep_flag(sweep, complete), complete = TRUE.

// The boundary of a deadline whose start observation belongs to the same run.
.decl deadline_until(run: symbol, step: symbol, deadline: symbol, start: symbol, until: number)
deadline_until(run, step, deadline, start, until) :-
    loop_deadline__run(deadline, run), loop_deadline__step(deadline, step),
    loop_deadline__start(deadline, start), loop_deadline__budget(deadline, budget),
    loop_observation__run(start, run), loop_observation__event_time(start, started),
    until = started + budget.

// A deadline must count from a start observation of its own run; another run's start cannot date it.
// @invariant
.decl deadline_foreign_start(deadline: symbol)
deadline_foreign_start(deadline) :-
    loop_deadline__run(deadline, run), loop_deadline__start(deadline, start),
    loop_observation__run(start, other), other != run.

// A completion observation at time is invalidated if a simultaneous or later observation in the same
// active run disagrees with the expected known state or value.
.decl completion_invalidated_at(run: symbol, token: symbol, time: number)
completion_invalidated_at(run, token, time) :-
    active(run), expectation(token, value),
    observed(run, token, time, _, "known", value, _),
    observed(run, token, other_time, _, state, _, _),
    other_time >= time, state != "known".
completion_invalidated_at(run, token, time) :-
    active(run), expectation(token, value),
    observed(run, token, time, _, "known", value, _),
    observed(run, token, other_time, _, "known", other, _),
    other_time >= time, other != value.

// A step met its deadline when it is done and an uncontradicted completion observation was recorded
// at or after the deadline start and at or before the boundary, with no conflicting or regressed
// observation at or after that time.
.decl done_in_time(run: symbol, step: symbol, deadline: symbol)
done_in_time(run, step, deadline) :-
    deadline_until(run, step, deadline, start, until),
    loop_observation__event_time(start, started),
    done(run, step, _),
    completion(run, step, token, _), expectation(token, value),
    observed(run, token, time, _, "known", value, _),
    started <= time, time <= until,
    !completion_invalidated_at(run, token, time).

// At the inclusive boundary of its budget a step that did not finish in time has expired.
// The current sweep only dates the round, so an incomplete sweep expires a deadline too.
// Expiry is terminal: a completion observed after the boundary does not clear it.
.decl deadline_expired(run: symbol, step: symbol, sweep: symbol, deadline: symbol, start: symbol)
deadline_expired(run, step, sweep, deadline, start) :-
    deadline_until(run, step, deadline, start, until),
    current_sweep(run, sweep, time), until <= time,
    declared(run, step, _), !done_in_time(run, step, deadline).
