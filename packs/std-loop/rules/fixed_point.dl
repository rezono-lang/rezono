.decl possible_progress(run: symbol)
possible_progress(run) :- ready(run, _, _).
possible_progress(run) :-
    waiting(run, _, token, _),
    loop_pending_operation__run(operation, run), loop_pending_operation__token(operation, token).

.decl fixed_point(run: symbol, sweep: symbol, step: symbol, token: symbol, requirement: symbol)
fixed_point(run, sweep, step, token, requirement) :-
    loop_sweep_receipt__run(sweep, run), loop_sweep_receipt__event_time(sweep, _),
    waiting(run, step, token, requirement), !possible_progress(run).

.output fixed_point
