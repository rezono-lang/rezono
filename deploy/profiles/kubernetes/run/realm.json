{
  "realm": "rede",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{ "name": "rede-readers" }],
  "users": [
    {
      "username": "reader",
      "enabled": true,
      "email": "reader@example.test",
      "emailVerified": true,
      "firstName": "A",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "@READER_PASSWORD@", "temporary": false }],
      "groups": ["/rede-readers"]
    },
    {
      "username": "stranger",
      "enabled": true,
      "email": "stranger@example.test",
      "emailVerified": true,
      "firstName": "A",
      "lastName": "Stranger",
      "credentials": [{ "type": "password", "value": "@STRANGER_PASSWORD@", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "rede",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "@CLIENT_SECRET@",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://rezono.example.test/oauth2/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
