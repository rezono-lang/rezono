          "options": [{"explain": "fold"}],
          "when": {
            "or": [
              {
                "and": [
                  {"call": ["ordering.Alpha.related", [{"wildcard": true}, {"path": ["at"]}]]},
                  {"not": {"call": ["ordering.count", [{"path": ["at"]}]]}}
                ]
              },
              {
                "cmp": [
                  ">=",
                  {
                    "agg": [
                      "count",
                      {
                        "filter": [
                          {"call": ["Alpha.related", [{"wildcard": true}, {"path": ["at"]}]]},
                          {"is": [{"path": ["it", "active"]}, "known"]}
                        ]
                      }
                    ]
                  },
                  {"arith": ["+", {"lit": "1"}, {"arith": ["*", {"lit": "2"}, {"lit": "3"}]}]}
                ]
              }
            ]
          }
        },
        {
          "rule": "replaces",
          "args": [{"path": ["x"]}, {"path": ["x", "at"]}],
          "locals": [{"name": "local", "type": "ordering.Alpha"}],
          "when": {"in": [{"path": ["x"]}, {"kind": "ordering.Alpha"}]}
