rezono 0
pack library

schema library
  iri "https://rezono.example/library"
  language nl
  import "linkml:types"
  default range Text
  description "Een bibliotheek: vestigingen met een adres, een boom van categorieën, werken en exemplaren, leden en personeel als personen, en uitleningen als waarnemingen."
  annotation layer = "facts"

enum MembershipType world closed = youth | adult

embedded kind Address world closed
  description "Heeft geen eigen identificatie; bestaat alleen ingebed in een vestiging."
  street: Text
  city: Text
  postcode: Text?
    pattern "^[1-9][0-9]{3} ?[A-Z]{2}$"

kind Branch world closed
  code: Text identifier
  name: Text
  address: Address embedded

kind Category world closed
  id: Text identifier
  name: Text
  parent: Category?
  unique name_within_parent = parent, name

kind Work world closed
  id: Text identifier
  title: Text
  category: Category
  year: Int?
    minimum 1450
  authors: Text*
    cardinality 1..3

kind Copy world closed
  barcode: Int identifier
  work: Work
  branch: Branch
  reference_only: Bool

abstract kind Person world closed
  id: Text identifier
  name: Text

kind Member is Person world closed
  membership: MembershipType
  home_branch: Branch?
  require rule_1 when membership = adult then home_branch is known
    description "Een volwassen lid heeft een thuisvestiging."

kind Staff is Person world closed
  branch: Branch

kind Loan world closed
  annotation layer = "observation"
  id: Text identifier
  copy: Copy
  member: Member
  lent_by: Staff
  lent_on: Date
  equal lent_at_home = copy.branch, lent_by.branch
