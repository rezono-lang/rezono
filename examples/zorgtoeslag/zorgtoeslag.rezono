rezono 0
pack zorgtoeslag
use std.money                          -- EUR, €
use std.units                          -- d, month, year

--- A small slice of the Dutch healthcare allowance (Wet op de zorgtoeslag, Awir), written to test
--- Rezono v0 before the freeze (#401 D28). Amounts, rates and article numbers are illustrative,
--- not the published figures. Not an application: Rezono verifies such rules, it does not execute them.

rounding date down                     -- 2026-02-29 does not exist: an 18th birthday falls on 2026-02-28
rounding money down                    -- monthly payments in whole euros, rounded down

unit Euro = money EUR                  -- whole euros, for the monthly payment

reason no_estimate = "no income estimate yet"
reason no_cover_report = "the insurer has not reported the cover yet"

enum Ground = minor | uninsured | income_too_high

kind Person  world closed
  birth_date: Date
  insured_from: Date?                  -- health insurance cover; absent: never insured
  insured_until: Date?                 -- absent: still insured
  household: Household
  income: Money<EUR>                   -- toetsingsinkomen; a version per calendar year

kind Household  world closed
  claimant: Person
  members: Person+ inverse household   -- the claimant and a toeslagpartner, if any

kind ClaimMonth  world closed
  applies at: first_day
  sealed at: closed_on
  household: Household
  first_day: Date
  closed_on: DateTime?

-- Parameters are read at the month's date, so they are declared per ClaimMonth (README, gap G1).
param standard_premium: Money<EUR> per ClaimMonth
  version 1, valid 2025-01-01..<2026-01-01, known 2024-09-17  = € 2112.00  @ regeling-zt#art-1
  version 2, valid 2026-01-01.., known 2025-09-16             = € 2180.00  @ regeling-zt#art-1
  version 3, valid 2026-01-01.., known 2026-03-02             = € 2190.00  @ wijziging-zt#art-I

param threshold_income: Money<EUR> per ClaimMonth
  version 1, valid 2025-01-01..<2026-01-01, known 2024-09-17  = € 28406.00  @ awir#art-2.1
  version 2, valid 2026-01-01.., known 2025-09-16             = € 29600.00  @ awir#art-2.1

param income_limit_single: Money<EUR> per ClaimMonth
  version 1, valid 2025-01-01..<2026-01-01, known 2024-09-17  = € 38520.00  @ wzt#art-2.2
  version 2, valid 2026-01-01.., known 2025-09-16             = € 39719.00  @ wzt#art-2.2

param income_limit_partner: Money<EUR> per ClaimMonth
  version 1, valid 2025-01-01..<2026-01-01, known 2024-09-17  = € 48224.00  @ wzt#art-2.2
  version 2, valid 2026-01-01.., known 2025-09-16             = € 50206.00  @ wzt#art-2.2

param rate_above: Ratio = 13.7 %

extend ClaimMonth
  derived has_partner: Bool = household.members.count() = 2

  derived adult: Bool = household.claimant.birth_date + 18 year <= first_day

  -- Absent cover is a decided "not insured"; an unknown start stays unknown (Z21, README F1).
  derived insured: Bool =
      when household.claimant.insured_from is n/a then false
      else household.claimant.insured_from <= first_day
           and (household.claimant.insured_until is n/a or first_day < household.claimant.insured_until)

  -- The income of the year the month lies in (README, gap G2: time selection is reserved).
  derived joint_income: Money<EUR> = household.members.sum(income at first_day)

  derived income_limit: Money<EUR> =
      when has_partner then income_limit_partner else income_limit_single

  derived threshold_rate: Ratio
    table unique
      | has_partner | -> threshold_rate |
      | false       | 1.879 %           |
      | true        | 4.256 %           |

  derived household_premium: Money<EUR> =
      when has_partner then 2 * standard_premium else standard_premium

  derived norm_premium: Money<EUR> =
      threshold_rate * threshold_income
      + rate_above * (when joint_income > threshold_income then joint_income - threshold_income else € 0.00)

  derived yearly_amount: Money<EUR> =
      when household_premium > norm_premium then household_premium - norm_premium else € 0.00

  derived allowance: Euro = round(yearly_amount / 12)
    unless                                               -- block form: only it carries a source (README, G6)
      when not adult then € 0                            @ wzt#art-2.1
    unless
      when not insured then € 0                          @ wzt#art-2.1
    unless
      when joint_income > income_limit then € 0          @ wzt#art-2.2

  derived grounds: Ground*
    table collect
      | adult | insured | joint_income > income_limit | -> grounds      |
      | false | -       | -                           | minor           |
      | -     | false   | -                           | uninsured       |
      | -     | -       | true                        | income_too_high |

check claimant_is_member: claim_month.household.claimant in claim_month.household.members
check allowance_cap: claim_month.allowance <= € 200
