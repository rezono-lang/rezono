  "messages": [
    {
      "lang": "nl",
      "resource": "@locale nl\n---\n# Zinnen bij de olog in ICU MessageFormat 2, één bericht per id.\n# Een bericht begint in de eerste kolom met \"id =\"; vervolgregels springen in.\n# Elk argument is een element-id. De viewer vult $x met het label van x en\n# $x_gender met het geslacht van dat label, of \"other\" als het er niet is.\narrow.total =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Elk {$kind} heeft precies één {$arrow}.}}\n  * {{Elke {$kind} heeft precies één {$arrow}.}}\narrow.partial =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Elk {$kind} heeft hoogstens één {$arrow}.}}\n  * {{Elke {$kind} heeft hoogstens één {$arrow}.}}\nattribute.total =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Elk {$kind} heeft precies één {$attribute}.}}\n  * {{Elke {$kind} heeft precies één {$attribute}.}}\nattribute.partial =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Elk {$kind} heeft hoogstens één {$attribute}.}}\n  * {{Elke {$kind} heeft hoogstens één {$attribute}.}}\nis_a =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Elk {$kind} is een {$parent}.}}\n  * {{Elke {$kind} is een {$parent}.}}\nunique_key = {$key} hoort bij hoogstens één {$kind}.\npath_equation =\n  .input {$kind_gender :string}\n  .match $kind_gender\n  neuter {{Voor elk {$kind} geldt: {$equation}.}}\n  * {{Voor elke {$kind} geldt: {$equation}.}}\n"
    }
  ],
