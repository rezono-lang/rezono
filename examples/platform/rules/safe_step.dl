// A request is judged only against observations and scope receipts of the cut it is evaluated in.
.decl safe_step_cut(run: symbol, cut: symbol)
safe_step_cut(run, cut) :- safe_round_cut__run(cut, run).

.decl safe_step_seen(run: symbol, cut: symbol, subject: symbol, attribute: symbol, value: symbol, obs: symbol)
safe_step_seen(run, cut, subject, attribute, value, obs) :-
    safe_step_cut(run, cut),
    safe_step_observation__run(obs, run), safe_step_observation__cut(obs, cut),
    safe_step_observation__subject(obs, subject), safe_step_observation__attribute(obs, attribute),
    safe_step_observation__value(obs, value).

.decl safe_step_covered(run: symbol, cut: symbol, reader: symbol, scope: symbol, receipt: symbol)
safe_step_covered(run, cut, reader, scope, receipt) :-
    safe_step_cut(run, cut),
    safe_step_scope__run(receipt, run), safe_step_scope__cut(receipt, cut),
    safe_step_scope__reader(receipt, reader), safe_step_scope__scope(receipt, scope).

// Exposing a listener needs an effective network policy and a router allowance for it.
// Two different values for one of these attributes in the same cut contradict each other and prove nothing.
.decl expose_contradicted(run: symbol, cut: symbol, subject: symbol)
expose_contradicted(run, cut, subject) :-
    safe_step_seen(run, cut, subject, "network-policy", value, _),
    safe_step_seen(run, cut, subject, "network-policy", other, _), value != other.
expose_contradicted(run, cut, subject) :-
    safe_step_seen(run, cut, subject, "router-policy", value, _),
    safe_step_seen(run, cut, subject, "router-policy", other, _), value != other.

.decl expose_router_allowed(run: symbol, cut: symbol, subject: symbol)
expose_router_allowed(run, cut, subject) :- safe_step_seen(run, cut, subject, "router-policy", "effective", _).

.decl expose_policy_read(run: symbol, cut: symbol, subject: symbol)
expose_policy_read(run, cut, subject) :- safe_step_seen(run, cut, subject, "network-policy", _, _).

.decl expose_policy_effective(run: symbol, cut: symbol, subject: symbol)
expose_policy_effective(run, cut, subject) :- safe_step_seen(run, cut, subject, "network-policy", "effective", _).

.decl expose_router_covered(run: symbol, cut: symbol, subject: symbol)
expose_router_covered(run, cut, subject) :- safe_step_covered(run, cut, "router", subject, _).

// Retiring a provider needs every consumer that runs on it to be stopped,
// read by a runtime reader that completely covered the provider in the same cut.
.decl retire_consumer_running(run: symbol, cut: symbol, consumer: symbol)
retire_consumer_running(run, cut, consumer) :- safe_step_seen(run, cut, consumer, "runtime", "running", _).

.decl retire_consumer_cleared(run: symbol, cut: symbol, provider: symbol, consumer: symbol)
retire_consumer_cleared(run, cut, provider, consumer) :-
    safe_step_covered(run, cut, "runtime", provider, _),
    safe_step_seen(run, cut, consumer, "runtime", "stopped", _),
    !retire_consumer_running(run, cut, consumer).

.decl startup_transition_result(run: symbol, cut: symbol, step: symbol, verdict: symbol, reason: symbol, subject: symbol)
startup_transition_result(run, cut, step, "safe", "effective-protection", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    safe_step_seen(run, cut, subject, "network-policy", "effective", _),
    safe_step_seen(run, cut, subject, "router-policy", "effective", _),
    !expose_contradicted(run, cut, subject).
startup_transition_result(run, cut, step, "unknown", "contradictory-observation", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    expose_contradicted(run, cut, subject).
startup_transition_result(run, cut, step, "blocked", "unprotected-listener", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    safe_step_covered(run, cut, "router", subject, _),
    !expose_router_allowed(run, cut, subject), !expose_contradicted(run, cut, subject).
startup_transition_result(run, cut, step, "blocked", "unprotected-listener", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    expose_router_allowed(run, cut, subject), expose_policy_read(run, cut, subject),
    !expose_policy_effective(run, cut, subject), !expose_contradicted(run, cut, subject).
startup_transition_result(run, cut, step, "unknown", "missing-network-policy-read", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    expose_router_allowed(run, cut, subject),
    !expose_policy_read(run, cut, subject), !expose_contradicted(run, cut, subject).
startup_transition_result(run, cut, step, "unknown", "missing-router-coverage", subject) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "expose"),
    safe_step_request__subject(step, subject),
    safe_step_cut(run, cut), !expose_router_allowed(run, cut, subject), !expose_router_covered(run, cut, subject),
    !expose_contradicted(run, cut, subject).

startup_transition_result(run, cut, step, "blocked", "provider-in-use", consumer) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "retire"),
    safe_step_request__subject(step, provider),
    service_need__provider(need, provider), service_need__consumer(need, consumer),
    service_need__mode(need, "run"),
    safe_step_cut(run, cut), retire_consumer_running(run, cut, consumer),
    safe_step_seen(run, cut, consumer, "runtime", "running", _).
startup_transition_result(run, cut, step, "safe", "consumer-stopped", consumer) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "retire"),
    safe_step_request__subject(step, provider),
    service_need__provider(need, provider), service_need__consumer(need, consumer),
    service_need__mode(need, "run"),
    safe_step_cut(run, cut), retire_consumer_cleared(run, cut, provider, consumer),
    safe_step_covered(run, cut, "runtime", provider, _),
    safe_step_seen(run, cut, consumer, "runtime", "stopped", _).
startup_transition_result(run, cut, step, "unknown", "missing-runtime-coverage", consumer) :-
    safe_step_request__run(step, run), safe_step_request__effect(step, "retire"),
    safe_step_request__subject(step, provider),
    service_need__provider(need, provider), service_need__consumer(need, consumer),
    service_need__mode(need, "run"),
    safe_step_cut(run, cut), !retire_consumer_running(run, cut, consumer),
    !retire_consumer_cleared(run, cut, provider, consumer).

.output startup_transition_result
