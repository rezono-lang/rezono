.decl tenant_delivery_request_order(tenant: symbol, service: symbol, submission: number, service_name: number)
.decl tenant_delivery_predecessor(tenant: symbol, service: symbol, prior_service: symbol)
.decl tenant_delivery_number(tenant: symbol, service: symbol, number: number)

tenant_delivery_request_order(t, s, submitted, name) :-
    tenant_service_request__tenant(r, t), tenant_service_request__service(r, s),
    tenant_service_request__submitted_at_key(r, submitted), tenant_service_request__service_key(r, name).

tenant_delivery_predecessor(t, s, prior) :-
    tenant_delivery_request_order(t, s, submitted, _), tenant_delivery_request_order(t, prior, earlier, _),
    earlier < submitted.

tenant_delivery_predecessor(t, s, prior) :-
    tenant_delivery_request_order(t, s, submitted, name), tenant_delivery_request_order(t, prior, submitted, earlier),
    earlier < name.

// Only services in the same tenant can contribute to the one-based ordinal.
tenant_delivery_number(t, s, number) :-
    tenant_delivery_request_order(t, s, _, _),
    predecessors = count : { tenant_delivery_predecessor(t, s, _) },
    number = predecessors + 1.

.output tenant_delivery_number
