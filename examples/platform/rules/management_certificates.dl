// Caller-bound certificate requirements, trust chains and validity checks.

.decl tls_required(req: symbol, caller: symbol, name: symbol)
tls_required(req, caller, name) :-
    tls_requirement__transport(req, "tls"),
    tls_requirement__caller(req, caller),
    tls_requirement__name(req, name).

.decl tls_trusted_authority(caller: symbol, authority: symbol)
tls_trusted_authority(caller, authority) :-
    tls_root__caller(root, caller),
    tls_root__authority(root, authority).
tls_trusted_authority(caller, authority) :-
    tls_issuer__issuer(authority, parent),
    tls_trusted_authority(caller, parent).

.decl tls_eval_clock(day_num: number, warning_days: number)
tls_eval_clock(day_num, warning_days) :-
    tls_clock(clock),
    tls_clock__day(clock, day),
    tls_clock__warning_days(clock, warning_days),
    clocks = count : { tls_clock(_) },
    clocks = 1,
    warning_days >= 0,
    day_num = @days(day, "1970-01-01").

.decl tls_eval_clock_present(service: symbol)
tls_eval_clock_present(req) :-
    tls_required(req, _, _),
    tls_eval_clock(_, _).

.decl tls_read_complete(service: symbol)
tls_read_complete(service) :-
    tls_read__service(read, service),
    tls_read__complete(read, TRUE).

.decl tls_leaf_observed(service: symbol, leaf: symbol, dns_name: symbol, issuer: symbol, begins: symbol, ends: symbol)
tls_leaf_observed(service, leaf, dns_name, issuer, begins, ends) :-
    tls_leaf__service(leaf, service),
    tls_leaf__read(leaf, read),
    tls_read__service(read, service),
    tls_leaf__dns_name(leaf, dns_name),
    tls_leaf__issuer(leaf, issuer),
    tls_leaf__begins(leaf, begins),
    tls_leaf__ends(leaf, ends).

.decl tls_leaf_present(service: symbol)
tls_leaf_present(service) :-
    tls_leaf_observed(service, _, _, _, _, _).

.decl managed_tls_finding(service: symbol, finding: symbol)
managed_tls_finding(req, "missing") :-
    tls_required(req, _, _),
    tls_read_complete(req),
    !tls_leaf_present(req).
managed_tls_finding(req, "wrong-name") :-
    tls_required(req, _, expected_name),
    tls_leaf_observed(req, _, dns_name, _, _, _),
    dns_name != expected_name.
managed_tls_finding(req, "untrusted-chain") :-
    tls_required(req, caller, _),
    tls_leaf_observed(req, _, _, issuer, _, _),
    !tls_trusted_authority(caller, issuer).
managed_tls_finding(req, "not-yet-valid") :-
    tls_required(req, _, _),
    tls_leaf_observed(req, _, _, _, begins, _),
    tls_eval_clock(day_num, _),
    begins_num = @days(begins, "1970-01-01"),
    day_num < begins_num.
managed_tls_finding(req, "expired") :-
    tls_required(req, _, _),
    tls_leaf_observed(req, _, _, _, _, ends),
    tls_eval_clock(day_num, _),
    ends_num = @days(ends, "1970-01-01"),
    day_num >= ends_num.
managed_tls_finding(req, "expiring") :-
    tls_required(req, _, _),
    tls_leaf_observed(req, _, _, _, begins, ends),
    tls_eval_clock(day_num, warning_days),
    begins_num = @days(begins, "1970-01-01"),
    ends_num = @days(ends, "1970-01-01"),
    begins_num <= day_num,
    day_num < ends_num,
    warning_end = day_num + warning_days,
    ends_num <= warning_end.

.decl managed_tls_unknown(service: symbol)
managed_tls_unknown(req) :-
    tls_required(req, _, _),
    !tls_leaf_present(req),
    !tls_read_complete(req).
managed_tls_unknown(req) :-
    tls_required(req, _, _),
    tls_leaf_present(req),
    !tls_eval_clock_present(req).

.output managed_tls_finding
.output managed_tls_unknown
