{"format":"rezono.module/2","module":{"decls":[{"lines":["// Who may read what (std-access). An element is typed: (kind, id). A role without a","// row here reads nothing, and a role sees a conclusion only with a proof from rows it reads.","//","// Every role reads the scheme, the public too: one rule over every role per kind says so (Y1.2). So","// `public` sees each amount and rate with the council decision it stands on, and that the decision is in","// force on the reference date. It reads no household, no application and no register, and therefore sees","// no award: a conclusion that rests on a row a role may not read is not shown to it, not even as","// \"unknown\".","//","// The case officer and the policy adviser read the cases with everything an award rests on, so both see","// every award with its proof. Only the case officer reads the payment ledger and its closes: the policy","// adviser sees no payment, no refused payment and no drift.","",".decl may_read(role: symbol, kind: symbol, element: symbol)","// The scheme, the roles themselves, and the reference date on which a decision is read as in force","// (std-decision): for every role.","may_read(r, \"article\", x) :- role(r), article(x).","may_read(r, \"decision\", x) :- role(r), decision(x).","// Why a decision is so (std-decision, the justification layer): read with the decision, by every role.","may_read(r, \"purpose\", x) :- role(r), purpose(x).","may_read(r, \"principle\", x) :- role(r), principle(x).","may_read(r, \"alternative\", x) :- role(r), alternative(x).","may_read(r, \"exception\", x) :- role(r), exception(x).","may_read(r, \"scheme_parameter\", x) :- role(r), scheme_parameter(x).","may_read(r, \"cost_item\", x) :- role(r), cost_item(x).","may_read(r, \"reference_date\", x) :- role(r), reference_date(x).","may_read(r, \"role\", x) :- role(r), role(x).","// The calendar on which a validity and the reference date are compared (std-time, views.yaml).","may_read(r, \"calendar\", x) :- role(r), calendar(x).","// std-time's own kinds. The pack states no element of them (a scheme parameter, the evaluation day and the","// calendar are read as an Interval, a ReferencePoint and an Axis through views.yaml, and stay what they are),","// so these grant no element. They say that a role reads std-time's own tables in full. So what the theory","// concludes over the scheme is read in full too, and a role may read what rests on the absence of a row the","// view leaves unmapped: that a validity ended without an extension (judgement), and that nobody recorded","// from which day a parameter is known. What a judgement says of a parameter still rests on the parameter's","// own dates, which a role reads only as a scheme parameter.","may_read(r, \"interval\", x) :- role(r), interval(x).","may_read(r, \"axis\", x) :- role(r), axis(x).","may_read(r, \"reference_point\", x) :- role(r), reference_point(x).","may_read(r, \"series\", x) :- role(r), series(x).","","// The cases: households, applications, quotes and the two registers. Each role that reads them is named","// in a rule of its own, with the kind and nothing else in its body. A rule over every role would give","// the public every case; and a role gets a sum, an absence or an award over a kind only if a rule gives","// it that kind without a further condition.","may_read(\"case_officer\", \"household\", x) :- household(x).","may_read(\"case_officer\", \"application\", x) :- application(x).","may_read(\"case_officer\", \"cost_line\", x) :- cost_line(x).","may_read(\"case_officer\", \"income_statement\", x) :- income_statement(x).","may_read(\"case_officer\", \"advice_report\", x) :- advice_report(x).","may_read(\"policy_adviser\", \"household\", x) :- household(x).","may_read(\"policy_adviser\", \"application\", x) :- application(x).","may_read(\"policy_adviser\", \"cost_line\", x) :- cost_line(x).","may_read(\"policy_adviser\", \"income_statement\", x) :- income_statement(x).","may_read(\"policy_adviser\", \"advice_report\", x) :- advice_report(x).","","// The ledger, for the case officer alone. Again each kind without a further condition, so the case","// officer reads it in full: only then does a role get a sum over it (ledger_paid) and its seal.","may_read(\"case_officer\", \"ledger_payment\", x) :- ledger_payment(x).","may_read(\"case_officer\", \"period_close\", x) :- period_close(x).","// A cover (closed_payment) is inlined in a close and read with it.","may_read(\"case_officer\", \"closed_payment\", x) :- closed_payment(x).","","// The deployment's roles (facts/roles.yaml; deploy/profiles/edge.yaml). `viewer` reads the cases as the","// policy adviser does, `propose` as the case officer does, the ledger included: in full, with the sum and","// the seal. So the published pack shows both sides of O8: a reader sees no payment and no drift, a","// proposer does.","may_read(\"viewer\", \"household\", x) :- household(x).","may_read(\"viewer\", \"application\", x) :- application(x).","may_read(\"viewer\", \"cost_line\", x) :- cost_line(x).","may_read(\"viewer\", \"income_statement\", x) :- income_statement(x).","may_read(\"viewer\", \"advice_report\", x) :- advice_report(x).","may_read(\"propose\", \"household\", x) :- household(x).","may_read(\"propose\", \"application\", x) :- application(x).","may_read(\"propose\", \"cost_line\", x) :- cost_line(x).","may_read(\"propose\", \"income_statement\", x) :- income_statement(x).","may_read(\"propose\", \"advice_report\", x) :- advice_report(x).","may_read(\"propose\", \"ledger_payment\", x) :- ledger_payment(x).","may_read(\"propose\", \"period_close\", x) :- period_close(x).","may_read(\"propose\", \"closed_payment\", x) :- closed_payment(x).","","// What other organisations state (schema/credentials.yaml): for the four roles that read the cases, each kind","// without a further condition, so each of them gets every claim's outcome and what is attested, with the proof.","// `public` reads none of it: a credential is about a person.","may_read(\"case_officer\", \"trust_entry\", x) :- trust_entry(x).","may_read(\"case_officer\", \"credential\", x) :- credential(x).","may_read(\"case_officer\", \"credential_claim\", x) :- credential_claim(x).","may_read(\"case_officer\", \"status_lookup\", x) :- status_lookup(x).","may_read(\"policy_adviser\", \"trust_entry\", x) :- trust_entry(x).","may_read(\"policy_adviser\", \"credential\", x) :- credential(x).","may_read(\"policy_adviser\", \"credential_claim\", x) :- credential_claim(x).","may_read(\"policy_adviser\", \"status_lookup\", x) :- status_lookup(x).","may_read(\"viewer\", \"trust_entry\", x) :- trust_entry(x).","may_read(\"viewer\", \"credential\", x) :- credential(x).","may_read(\"viewer\", \"credential_claim\", x) :- credential_claim(x).","may_read(\"viewer\", \"status_lookup\", x) :- status_lookup(x).","may_read(\"propose\", \"trust_entry\", x) :- trust_entry(x).","may_read(\"propose\", \"credential\", x) :- credential(x).","may_read(\"propose\", \"credential_claim\", x) :- credential_claim(x).","may_read(\"propose\", \"status_lookup\", x) :- status_lookup(x).","// The statements that two identifiers name one person (W4 step 2): for the same four roles, the same way.","may_read(\"case_officer\", \"identity_statement\", x) :- identity_statement(x).","may_read(\"policy_adviser\", \"identity_statement\", x) :- identity_statement(x).","may_read(\"viewer\", \"identity_statement\", x) :- identity_statement(x).","may_read(\"propose\", \"identity_statement\", x) :- identity_statement(x).","","// Explicit full-kind read coverage (decisions/central-read-access.md): each full-kind grant above","// carries a matching may_read_full(role, kind) clause.",".decl may_read_full(role: symbol, kind: symbol)","may_read_full(r, \"article\") :- role(r).","may_read_full(r, \"decision\") :- role(r).","may_read_full(r, \"purpose\") :- role(r).","may_read_full(r, \"principle\") :- role(r).","may_read_full(r, \"alternative\") :- role(r).","may_read_full(r, \"exception\") :- role(r).","may_read_full(r, \"scheme_parameter\") :- role(r).","may_read_full(r, \"cost_item\") :- role(r).","may_read_full(r, \"reference_date\") :- role(r).","may_read_full(r, \"role\") :- role(r).","may_read_full(r, \"calendar\") :- role(r).","may_read_full(r, \"interval\") :- role(r).","may_read_full(r, \"axis\") :- role(r).","may_read_full(r, \"reference_point\") :- role(r).","may_read_full(r, \"series\") :- role(r).","","may_read_full(\"case_officer\", \"household\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"application\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"cost_line\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"income_statement\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"advice_report\") :- role(\"case_officer\").","may_read_full(\"policy_adviser\", \"household\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"application\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"cost_line\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"income_statement\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"advice_report\") :- role(\"policy_adviser\").","","may_read_full(\"case_officer\", \"ledger_payment\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"period_close\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"closed_payment\") :- role(\"case_officer\").","","may_read_full(\"viewer\", \"household\") :- role(\"viewer\").","may_read_full(\"viewer\", \"application\") :- role(\"viewer\").","may_read_full(\"viewer\", \"cost_line\") :- role(\"viewer\").","may_read_full(\"viewer\", \"income_statement\") :- role(\"viewer\").","may_read_full(\"viewer\", \"advice_report\") :- role(\"viewer\").","may_read_full(\"propose\", \"household\") :- role(\"propose\").","may_read_full(\"propose\", \"application\") :- role(\"propose\").","may_read_full(\"propose\", \"cost_line\") :- role(\"propose\").","may_read_full(\"propose\", \"income_statement\") :- role(\"propose\").","may_read_full(\"propose\", \"advice_report\") :- role(\"propose\").","may_read_full(\"propose\", \"ledger_payment\") :- role(\"propose\").","may_read_full(\"propose\", \"period_close\") :- role(\"propose\").","may_read_full(\"propose\", \"closed_payment\") :- role(\"propose\").","","may_read_full(\"case_officer\", \"trust_entry\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"credential\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"credential_claim\") :- role(\"case_officer\").","may_read_full(\"case_officer\", \"status_lookup\") :- role(\"case_officer\").","may_read_full(\"policy_adviser\", \"trust_entry\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"credential\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"credential_claim\") :- role(\"policy_adviser\").","may_read_full(\"policy_adviser\", \"status_lookup\") :- role(\"policy_adviser\").","may_read_full(\"viewer\", \"trust_entry\") :- role(\"viewer\").","may_read_full(\"viewer\", \"credential\") :- role(\"viewer\").","may_read_full(\"viewer\", \"credential_claim\") :- role(\"viewer\").","may_read_full(\"viewer\", \"status_lookup\") :- role(\"viewer\").","may_read_full(\"propose\", \"trust_entry\") :- role(\"propose\").","may_read_full(\"propose\", \"credential\") :- role(\"propose\").","may_read_full(\"propose\", \"credential_claim\") :- role(\"propose\").","may_read_full(\"propose\", \"status_lookup\") :- role(\"propose\").","may_read_full(\"case_officer\", \"identity_statement\") :- role(\"case_officer\").","may_read_full(\"policy_adviser\", \"identity_statement\") :- role(\"policy_adviser\").","may_read_full(\"viewer\", \"identity_statement\") :- role(\"viewer\").","may_read_full(\"propose\", \"identity_statement\") :- role(\"propose\").","",".output may_read"],"rules":"access"}],"pack":"subsidy","rezono":"0","use":[]},"spans":[{"at":"/decls/0","end":"35","line":"4","start":"29"}]}