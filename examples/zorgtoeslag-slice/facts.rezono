pack zorgtoeslag-slice

-- Case data for allowance-cases.yaml (decisions/language-healthcare-allowance-slice.md). Households and amounts
-- are invented. An amount is a whole number of cents: 2400000 is EUR 24,000.00.

fact Household
  | id  | partner |
  | ann | false   |
  | bob | true    |
  | dex | false   |
  | eve | false   |
  | fay | false   |
  | gus | false   |
  | hal | false   |
  | ivy | false   |
  | kim | true    |

-- Health insurance cover of the claimant: a version per period. Ivy's insurer has not reported yet,
-- so no version applies.
fact household ann, valid 2020-01-01.., known 2020-01-05
  insured = true
fact household bob, valid 2015-01-01.., known 2015-01-05
  insured = true
fact household dex, valid 2008-02-29..<2026-03-01, known 2008-03-05
  insured = false
fact household dex, valid 2026-03-01.., known 2026-02-20
  insured = true
fact household eve, valid 1970-01-01.., known 1970-01-05
  insured = false
fact household fay, valid 2010-01-01.., known 2010-01-05
  insured = true
fact household gus, valid 2018-01-01.., known 2018-01-05
  insured = true
fact household hal, valid 2019-01-01.., known 2019-01-05
  insured = true
fact household kim, valid 2012-01-01.., known 2012-01-05
  insured = true

-- The joint income of the household: a version per calendar year. Hal has no estimate for 2026.
fact household ann, valid 2025-01-01..<2026-01-01, known 2025-01-10
  joint_income = 2400000
fact household ann, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 2500000
fact household bob, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 4300000
fact household dex, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 400000
fact household eve, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 2000000
fact household fay, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 4500000
fact household gus, valid 2026-01-01..<2027-01-01, known 2026-01-05
  joint_income = 2800000
fact household gus, valid 2026-01-01..<2027-01-01, known 2026-04-15     -- a corrected estimate, back to January
  joint_income = 3400000
fact household ivy, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 2000000
fact household kim, valid 2026-01-01..<2027-01-01, known 2025-12-01
  joint_income = 5100000
