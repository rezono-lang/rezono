rezono 0
pack zorgtoeslag-slice

use zorgtoeslag-person
use zorgtoeslag-civil as civil
use zorgtoeslag-tax as tax
use zorgtoeslag-insurer as insurer

--- Three-source healthcare allowance slice (decisions/healthcare-allowance-three-sources.md).
--- Combines independent civil, tax, and insurer sources along shared synthetic Persoon keys.
--- Statutory benefit partnership (toeslagpartner) is derived in rules/allowance.dl citing
--- @ awr#art-5a and @ awir#art-3; civil.Partner and tax.Partner remain distinct kinds.
--- Amounts, rates and versions are synthetic test figures in whole cents (218000 is EUR 2,180.00).

kind SchemeParameter world closed
  name: Text
  value: Int
  valid_from: Date
    iri "http://schema.org/validFrom"
  valid_until: Date
    iri "http://schema.org/validThrough"
  known_from: Date
    iri "http://www.w3.org/ns/prov#generatedAtTime"

kind EvaluationDay world closed
  as_of_day: Int
  known_day: Int

param standard_premium: Int from SchemeParameter.value by name
param threshold_income: Int from SchemeParameter.value by name
param income_limit_single: Int from SchemeParameter.value by name
param income_limit_partner: Int from SchemeParameter.value by name

extend Persoon
  derived insured: Bool = insured_flag.value = 1
    unit flag

  derived income_limit: Int =
      when has_toeslagpartner then income_limit_partner else income_limit_single
    unit cents

  derived threshold_rate: Ratio =
      when has_toeslagpartner then 4.256 % else 1.879 %
    unit ratio

  derived household_premium: Int =
      when has_toeslagpartner then 2 * standard_premium else standard_premium
    unit cents

  derived norm_premium: Int =
      threshold_rate * threshold_income
      + 13.7 % * (when joint_income.cents > threshold_income then joint_income.cents - threshold_income else 0)
    unit cents

  derived yearly_amount: Int =
      when household_premium > norm_premium then household_premium - norm_premium else 0
    unit cents

  -- The monthly allowance, rounded down to whole euros. The lower block is read first (v0 section 5b).
  derived allowance: Int = floor(yearly_amount / 1200) * 100
    unit cents
    unless
      when not insured then 0                            @ wzt#art-2.1
    unless
      when joint_income.cents > income_limit then 0      @ wzt#art-2.2
