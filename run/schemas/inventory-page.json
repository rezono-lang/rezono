{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sweep_id", "page_id", "next_page_id", "resources"],
  "properties": {
    "sweep_id": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "next_page_id": {"type": ["string", "null"], "minLength": 1},
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "plan_hash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "plan_hash": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      }
    }
  }
}
