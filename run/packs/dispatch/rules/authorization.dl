// Each source identifies the dispatch attempt it describes. Competing source rows
// or contradictory claims on a single source cannot authorize the attempt.
.decl conflicting_input(candidate: symbol)
conflicting_input(c) :- plan__candidate(a, c), plan__candidate(b, c), a != b.
conflicting_input(c) :- plan__candidate(s, c), plan__candidate(s, d), c != d.
conflicting_input(c) :- plan__candidate(s, c), plan__plan_hash(s, a), plan__plan_hash(s, b), a != b.
conflicting_input(c) :- plan__candidate(s, c), plan__currency(s, a), plan__currency(s, b), a != b.

conflicting_input(c) :- quote__candidate(a, c), quote__candidate(b, c), a != b.
conflicting_input(c) :- quote__candidate(s, c), quote__candidate(s, d), c != d.
conflicting_input(c) :- quote__candidate(s, c), quote__plan_hash(s, a), quote__plan_hash(s, b), a != b.
conflicting_input(c) :- quote__candidate(s, c), quote__currency(s, a), quote__currency(s, b), a != b.
conflicting_input(c) :- quote__candidate(s, c), quote__cost_micros(s, a), quote__cost_micros(s, b), a != b.

conflicting_input(c) :- approval__candidate(a, c), approval__candidate(b, c), a != b.
conflicting_input(c) :- approval__candidate(s, c), approval__candidate(s, d), c != d.
conflicting_input(c) :- approval__candidate(s, c), approval__plan_hash(s, a), approval__plan_hash(s, b), a != b.
conflicting_input(c) :- approval__candidate(s, c), approval__currency(s, a), approval__currency(s, b), a != b.
conflicting_input(c) :- approval__candidate(s, c), approval__decision(s, a), approval__decision(s, b), a != b.
conflicting_input(c) :- approval__candidate(s, c), approval__cap_micros(s, a), approval__cap_micros(s, b), a != b.
conflicting_input(c) :- approval__candidate(s, c), approval__expires_us(s, a), approval__expires_us(s, b), a != b.

conflicting_input(c) :- observation__candidate(a, c), observation__candidate(b, c), a != b.
conflicting_input(c) :- observation__candidate(s, c), observation__candidate(s, d), c != d.
conflicting_input(c) :- observation__candidate(s, c), observation__event_us(s, a), observation__event_us(s, b), a != b.

.decl authorized(candidate: symbol)
authorized(c) :- candidate(c),
    plan(p), plan__candidate(p, c), plan__plan_hash(p, hash), plan__currency(p, currency),
    quote(q), quote__candidate(q, c), quote__plan_hash(q, hash), quote__currency(q, currency),
    quote__cost_micros(q, cost),
    approval(a), approval__candidate(a, c), approval__plan_hash(a, hash), approval__currency(a, currency),
    approval__decision(a, "approve"), approval__cap_micros(a, cap), approval__expires_us(a, expires),
    observation(o), observation__candidate(o, c), observation__event_us(o, event),
    cost >= 0, cost <= cap, event < expires, !conflicting_input(c).

.output authorized
