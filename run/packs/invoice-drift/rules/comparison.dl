.decl tagged_invoice(invoice_ref: symbol)
tagged_invoice(invoice_ref) :- invoice_line(invoice_ref), invoice_line__plan_hash(invoice_ref, _).

.decl invoice_binding(invoice_ref: symbol, expected_ref: symbol, plan: symbol, item: symbol, currency: symbol)
invoice_binding(invoice_ref, expected_ref, plan, item, currency) :-
    invoice_line(invoice_ref), expected_line(expected_ref),
    invoice_line__plan_hash(invoice_ref, plan), expected_line__plan_hash(expected_ref, plan),
    invoice_line__item(invoice_ref, item), expected_line__item(expected_ref, item),
    invoice_line__currency(invoice_ref, currency), expected_line__currency(expected_ref, currency).

.decl bound_invoice(invoice_ref: symbol)
bound_invoice(invoice_ref) :- invoice_binding(invoice_ref, _, _, _, _).

.decl invoice_binding_count(expected_ref: symbol, plan: symbol, item: symbol, currency: symbol, lines: number)
invoice_binding_count(expected_ref, plan, item, currency, lines) :-
    expected_line(expected_ref), expected_line__plan_hash(expected_ref, plan),
    expected_line__item(expected_ref, item), expected_line__currency(expected_ref, currency),
    lines = count : { invoice_binding(_, expected_ref, plan, item, currency) }.

.decl verified_invoice_amount(expected_ref: symbol, currency: symbol, rounding_ref: symbol, expected_minor: number)
verified_invoice_amount(expected_ref, currency, rounding_ref, expected_minor) :-
    verified_rounding(expected_ref, rounding_ref, expected_minor),
    expected_line__rounding_sha256(expected_ref, rounding_ref),
    rounding(rounding_ref), rounding__currency(rounding_ref, currency),
    rounding__source_url(rounding_ref, _), rounding__boundary(rounding_ref, "line"),
    rounding__mode(rounding_ref, _), rounding__minor_per_unit(rounding_ref, units), units > 0.

.decl invoice_amount_verification_count(expected_ref: symbol, currency: symbol, verifications: number)
invoice_amount_verification_count(expected_ref, currency, verifications) :-
    expected_line(expected_ref), expected_line__currency(expected_ref, currency),
    verifications = count : { verified_invoice_amount(expected_ref, currency, _, _) }.

.decl amount_difference(plan: symbol, item: symbol, expected_ref: symbol, invoice_ref: symbol,
    rounding_ref: symbol, expected_minor: number, observed_minor: number)
amount_difference(plan, item, expected_ref, invoice_ref, rounding_ref, expected_minor, observed_minor) :-
    invoice_binding(invoice_ref, expected_ref, plan, item, currency),
    invoice_binding_count(expected_ref, plan, item, currency, 1),
    invoice_amount_verification_count(expected_ref, currency, 1),
    verified_invoice_amount(expected_ref, currency, rounding_ref, expected_minor),
    invoice_line__minor(invoice_ref, observed_minor),
    expected_minor != observed_minor.

.decl unverifiable_invoice_amount(plan: symbol, item: symbol, currency: symbol, expected_ref: symbol,
    invoice_ref: symbol, observed_minor: number, reason: symbol)
unverifiable_invoice_amount(plan, item, currency, expected_ref, invoice_ref, observed_minor, "unverified_rounding") :-
    invoice_binding(invoice_ref, expected_ref, plan, item, currency),
    invoice_binding_count(expected_ref, plan, item, currency, 1),
    invoice_line__minor(invoice_ref, observed_minor),
    invoice_amount_verification_count(expected_ref, currency, verifications), verifications != 1.

.decl unbound_invoice(invoice_ref: symbol, reason: symbol)
unbound_invoice(invoice_ref, "missing_plan") :- invoice_line(invoice_ref), !tagged_invoice(invoice_ref).
unbound_invoice(invoice_ref, "unmatched_item") :- tagged_invoice(invoice_ref), !bound_invoice(invoice_ref).
unbound_invoice(invoice_ref, "ambiguous_binding") :-
    invoice_binding(invoice_ref, expected_ref, plan, item, currency),
    invoice_binding_count(expected_ref, plan, item, currency, lines), lines > 1.

.output amount_difference
.output unverifiable_invoice_amount
.output unbound_invoice
