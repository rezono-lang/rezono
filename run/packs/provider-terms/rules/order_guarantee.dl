// A usage-billed detail line removes any guarantee from the order.
.decl order_has_detail(order_ref: symbol)
order_has_detail(o) :- order_detail__order(_, o).

.decl detail_has_type(detail: symbol)
detail_has_type(d) :- order_detail__detail_type(d, _).

.decl order_has_usage_detail(order_ref: symbol)
order_has_usage_detail(o) :- order_detail__order(d, o), order_detail__detail_type(d, kind),
    usage_detail_type(kind).

.decl invalid_order(order_ref: symbol)
invalid_order(o) :- order(o), !order_has_detail(o).
invalid_order(o) :- order_detail__order(d, o), !detail_has_type(d).
invalid_order(o) :- order__expiration_us(o, a), order__expiration_us(o, b), a != b.
invalid_order(o) :- order__day_end_us(o, a), order__day_end_us(o, b), a != b.
invalid_order(o) :- order_detail__order(d, o), order_detail__order(d, other), o != other.
invalid_order(o) :- order_detail__order(d, o), order_detail__detail_type(d, a),
    order_detail__detail_type(d, b), a != b.

.decl conflicted_quote_policy(policy: symbol)
conflicted_quote_policy(p) :- quote_policy__mode(p, a), quote_policy__mode(p, b), a != b.
conflicted_quote_policy(p) :- quote_policy(p), quote_policy(other), p != other.

// Without a usage-billed detail, an unpaid order takes the provider quote mode and expires
// at the earlier of its recorded expirationDate and the next UTC midnight of the approved day.
.decl order_guarantee(order: symbol, mode: symbol, expires_us: number)
order_guarantee(o, mode, exp) :-
    order(o),
    !invalid_order(o),
    !order_has_usage_detail(o),
    quote_policy(policy),
    quote_policy__mode(policy, mode),
    !conflicted_quote_policy(policy),
    order__expiration_us(o, exp),
    order__day_end_us(o, day_end),
    exp <= day_end.
order_guarantee(o, mode, day_end) :-
    order(o),
    !invalid_order(o),
    !order_has_usage_detail(o),
    quote_policy(policy),
    quote_policy__mode(policy, mode),
    !conflicted_quote_policy(policy),
    order__expiration_us(o, exp),
    order__day_end_us(o, day_end),
    day_end < exp.

.output order_guarantee
