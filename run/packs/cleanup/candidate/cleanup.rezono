rezono 0
pack cleanup

rules cleanup
  | // A matching resource only establishes presence in the sweep that observed it.
  | .decl matching_resource(sweep: symbol, plan: symbol)
  | matching_resource(s, p) :- resource__sweep(r, s), resource__plan_hash(r, p).
  | 
  | .decl conflicting_sweep(sweep: symbol)
  | conflicting_sweep(s) :- sweep__coverage(s, a), sweep__coverage(s, b), a != b.
  | conflicting_sweep(s) :- sweep__plan_hash(s, a), sweep__plan_hash(s, b), a != b.
  | 
  | conflicting_sweep(s) :- sweep__coverage(s, c), c != "complete".
  | conflicting_sweep(s) :- sweep__run(s, a), sweep__run(s, b), a != b.
  | conflicting_sweep(s) :- sweep__scope(s, a), sweep__scope(s, b), a != b.
  | conflicting_sweep(s) :- sweep__attempt(s, a), sweep__attempt(s, b), a != b.
  | conflicting_sweep(s) :- sweep__started_us(s, a), sweep__started_us(s, b), a != b.
  | 
  | .decl conflicting_attempt(attempt: symbol)
  | conflicting_attempt(d) :- attempt__operation(d, a), attempt__operation(d, b), a != b.
  | conflicting_attempt(d) :- attempt__run(d, a), attempt__run(d, b), a != b.
  | conflicting_attempt(d) :- attempt__scope(d, a), attempt__scope(d, b), a != b.
  | conflicting_attempt(d) :- attempt__plan_hash(d, a), attempt__plan_hash(d, b), a != b.
  | conflicting_attempt(d) :- attempt__dispatched_us(d, a), attempt__dispatched_us(d, b), a != b.
  | 
  | .decl cleanup_evidence(sweep: symbol, attempt: symbol, terminal: symbol)
  | cleanup_evidence(s, d, last) :- complete_inventory(s, last),
  |     sweep__attempt(s, d), attempt(d), attempt__operation(d, "delete_resources"),
  |     sweep__run(s, run), attempt__run(d, run), run != "",
  |     sweep__scope(s, scope), attempt__scope(d, scope), scope != "",
  |     sweep__plan_hash(s, p), attempt__plan_hash(d, p), p != "",
  |     sweep__started_us(s, started), attempt__dispatched_us(d, sent), started > sent,
  |     !conflicting_attempt(d), !conflicting_sweep(s), !matching_resource(s, p).
  | 
  | .decl cleanup_page_evidence(sweep: symbol, attempt: symbol, page: symbol)
  | cleanup_page_evidence(s, d, r) :- cleanup_evidence(s, d, _), reached_page(s, r).
  | 
  | .decl cleaned(sweep: symbol)
  | cleaned(s) :- cleanup_evidence(s, _, _).
  | 
  | .decl invalid_listing(listing: symbol)
  | invalid_listing(l) :- listing(l), !listing__coverage(l, "complete").
  | invalid_listing(l) :- listing(l), listing__coverage(l, c), c != "complete".
  | invalid_listing(l) :- listing(l), !listing__unfiltered(l, TRUE).
  | invalid_listing(l) :- listing(l), listing__unfiltered(l, FALSE).
  | 
  | .decl conflicting_listed_service(item: symbol)
  | conflicting_listed_service(i) :- listed_service__listing(i, a), listed_service__listing(i, b), a != b.
  | conflicting_listed_service(i) :- listed_service__service(i, a), listed_service__service(i, b), a != b.
  | 
  | .decl has_listed_service_name(item: symbol)
  | has_listed_service_name(i) :- listed_service__service(i, _).
  | invalid_listing(l) :- listed_service__listing(i, l), !has_listed_service_name(i).
  | invalid_listing(l) :- listed_service__listing(i, l), conflicting_listed_service(i).
  | 
  | .decl conflicting_delivered_service(item: symbol)
  | conflicting_delivered_service(d) :- delivered_service__service(d, a), delivered_service__service(d, b), a != b.
  | 
  | // A delivered service that appears in a complete unfiltered listing is still listed.
  | .decl still_listed(listing: symbol, service: symbol)
  | still_listed(l, s) :-
  |     listing(l),
  |     !invalid_listing(l),
  |     listed_service(i),
  |     !conflicting_listed_service(i),
  |     listed_service__listing(i, l),
  |     listed_service__service(i, s),
  |     s != "",
  |     delivered_service(d),
  |     !conflicting_delivered_service(d),
  |     delivered_service__service(d, s).
  | 
  | .output cleaned, cleanup_evidence, cleanup_page_evidence, still_listed
