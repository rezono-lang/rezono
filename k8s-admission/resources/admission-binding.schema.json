{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezono.org/schemas/admission-binding-1.json",
  "title": "rezono.admission-binding/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "rule", "output", "match", "request", "parameters"],
  "properties": {
    "format": {"const": "rezono.admission-binding/1"},
    "rule": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "output": {"type": "string", "minLength": 1},
    "match": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resourceRule"}},
    "request": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/text"}},
    "resourceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiGroups", "apiVersions", "operations", "resources", "scope"],
      "properties": {
        "apiGroups": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "apiVersions": {"$ref": "#/$defs/textList"},
        "operations": {"type": "array", "minItems": 1, "items": {"enum": ["CREATE", "UPDATE"]}},
        "resources": {"$ref": "#/$defs/textList"},
        "scope": {"const": "Namespaced"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "each", "columns"],
      "properties": {
        "relation": {"$ref": "#/$defs/text"},
        "each": {"type": "array", "items": {"$ref": "#/$defs/iterator"}},
        "columns": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/column"}}
      }
    },
    "iterator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "path": {"$ref": "#/$defs/path"},
        "optional": {"type": "boolean"},
        "nonempty": {"type": "boolean"},
        "closed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "dependentRequired": {"end": ["reading"]},
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "default": {"type": ["string", "integer"]},
        "reading": {"const": "port-range"},
        "end": {"$ref": "#/$defs/path"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "lists"],
      "properties": {
        "scope": {"$ref": "#/$defs/text"},
        "lists": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/list"}}
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "columns"],
      "properties": {
        "field": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "not": {"const": "digest"}},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "fixed": {"type": "object", "additionalProperties": {"type": ["string", "integer"]}},
        "optional": {"type": "boolean"}
      }
    }
  }
}
