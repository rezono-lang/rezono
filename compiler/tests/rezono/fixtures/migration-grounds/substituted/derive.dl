.decl mid(item: symbol)
.decl other(item: symbol)
.decl tagged(cohort: symbol, item: symbol)
.decl listed(item: symbol)
.decl unmarked(item: symbol)
.decl total(n: number)
mid(item) :- alpha__title(item, "open").
other(item) :- alpha__title(item, "open").
tagged("left", item) :- alpha(item).
listed(item) :- other(item), alpha(item).
listed(item) :- alpha__title(item, "open").
unmarked(item) :- alpha(item), !mid(item).
total(n) :- n = count : { tagged("left", _) }.
