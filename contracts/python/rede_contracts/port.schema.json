{
    "$defs": {
        "Cadence": {
            "description": "The desired freshness of what the port reads or writes (O11).",
            "enum": [
                "live",
                "hourly",
                "daily",
                "on_request"
            ],
            "title": "Cadence",
            "type": "string"
        },
        "Loss": {
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "fate": {
                                "const": "extension"
                            }
                        },
                        "required": [
                            "fate"
                        ]
                    },
                    "then": {
                        "properties": {
                            "carried_by": {
                                "items": {},
                                "type": "array"
                            }
                        },
                        "required": [
                            "carried_by"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fate": {
                                "const": "weakened"
                            }
                        },
                        "required": [
                            "fate"
                        ]
                    },
                    "then": {
                        "properties": {
                            "carried_by": {
                                "items": {},
                                "type": "array"
                            }
                        },
                        "required": [
                            "carried_by"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fate": {
                                "const": "dropped"
                            }
                        },
                        "required": [
                            "fate"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "carried_by"
                            ]
                        },
                        "properties": {
                            "carried_by": {
                                "items": {},
                                "type": "array"
                            }
                        }
                    }
                }
            ],
            "description": "One part of the meaning that the mapping does not carry, and what happens to it.",
            "properties": {
                "carried_by": {
                    "description": "For `extension` the terms outside the standard that carry the part; for `weakened` the member of the target that keeps what is left. Absent for `dropped`.",
                    "items": {
                        "pattern": "^\\S+$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "fate": {
                    "$ref": "#/$defs/LossFate",
                    "description": "Dropped, weakened or carried by an extension."
                },
                "subject": {
                    "$ref": "#/$defs/LossSubject",
                    "description": "The part of the meaning that is lost."
                },
                "what": {
                    "description": "What exactly the reader on the other side does not get, in one or two sentences.",
                    "pattern": "\\S",
                    "type": "string"
                }
            },
            "required": [
                "subject",
                "what",
                "fate"
            ],
            "title": "Loss",
            "type": "object"
        },
        "LossDirection": {
            "description": "Which way the mapping runs, and so who loses.",
            "enum": [
                "out",
                "in"
            ],
            "title": "LossDirection",
            "type": "string"
        },
        "LossFate": {
            "description": "What happens to the part on the way.",
            "enum": [
                "dropped",
                "weakened",
                "extension"
            ],
            "title": "LossFate",
            "type": "string"
        },
        "LossList": {
            "additionalProperties": false,
            "description": "The loss list of one connector in one direction, as published beside what the connector writes. `losses` is required and is empty only when nothing is lost.",
            "properties": {
                "connector": {
                    "description": "The connector the list belongs to.",
                    "pattern": "^[a-z][a-z0-9]*([-_][a-z0-9]+)*$",
                    "type": "string"
                },
                "direction": {
                    "$ref": "#/$defs/LossDirection",
                    "description": "out or in."
                },
                "losses": {
                    "description": "One entry per loss.",
                    "items": {
                        "$ref": "#/$defs/Loss"
                    },
                    "type": "array"
                },
                "standard": {
                    "description": "The standard, for example PROV-O, SHACL, ODCS or DCAT.",
                    "pattern": "^\\S+$",
                    "type": "string"
                },
                "standard_version": {
                    "description": "The version of the standard the mapping is written against.",
                    "pattern": "^\\S+$",
                    "type": "string"
                }
            },
            "required": [
                "connector",
                "standard",
                "standard_version",
                "direction",
                "losses"
            ],
            "title": "LossList",
            "type": "object"
        },
        "LossSubject": {
            "description": "The part of the meaning that is lost. For `out` these are the parts of Rede's model (docs/concepts.md, \"The model\"); for `in` the entry names the standard's own construct in `what` and the nearest part here. A new part is a change of this contract.",
            "enum": [
                "state",
                "reason",
                "proof",
                "source",
                "rule",
                "check",
                "unit",
                "money",
                "time",
                "world",
                "access",
                "identity",
                "structure",
                "text"
            ],
            "title": "LossSubject",
            "type": "string"
        },
        "Port": {
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "in"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "effect"
                            ]
                        },
                        "properties": {
                            "effect": {},
                            "row_source": {
                                "const": "source"
                            },
                            "runs_on": {
                                "const": "source"
                            },
                            "writes": {
                                "const": "observation"
                            }
                        },
                        "required": [
                            "runs_on",
                            "writes",
                            "row_source"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "out"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "effect"
                            ]
                        },
                        "properties": {
                            "effect": {},
                            "row_source": {
                                "const": "output_index"
                            },
                            "runs_on": {
                                "const": "checked_epoch"
                            },
                            "writes": {
                                "const": "projection"
                            }
                        },
                        "required": [
                            "runs_on",
                            "writes",
                            "row_source"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "effect"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "properties": {
                            "effect": {},
                            "row_source": {
                                "const": "journal"
                            },
                            "runs_on": {
                                "const": "approved_plan"
                            },
                            "writes": {
                                "const": "world"
                            }
                        },
                        "required": [
                            "runs_on",
                            "writes",
                            "row_source",
                            "effect"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "out"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "footprint"
                            ]
                        },
                        "properties": {
                            "footprint": {}
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "effect"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "footprint"
                            ]
                        },
                        "properties": {
                            "footprint": {}
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "runtime": {
                                "const": "job"
                            }
                        },
                        "required": [
                            "runtime"
                        ]
                    },
                    "then": {
                        "properties": {
                            "image": {}
                        },
                        "required": [
                            "image"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "runtime": {
                                "const": "in_process"
                            }
                        },
                        "required": [
                            "runtime"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "image"
                            ]
                        },
                        "properties": {
                            "image": {}
                        }
                    }
                }
            ],
            "description": "The static declaration of a port. The kind fixes what a run starts from, what it writes and how each row names its source; the declaration states all three so a port that would write curated facts, or an out-port that would run on an unchecked epoch, cannot be declared.",
            "properties": {
                "connector": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PortConnector"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The external standard, when the port is a connector."
                },
                "consumes": {
                    "description": "The kinds read: sources, Output schemas, files or plans.",
                    "items": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "effect": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PortEffect"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The operations of an effect; required for kind effect only."
                },
                "footprint": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PortFootprint"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "What an in-port makes in its source for the length of a run; absent when it makes nothing. Kind in only."
                },
                "freshness": {
                    "$ref": "#/$defs/PortFreshness",
                    "description": "The port's freshness facts (O11)."
                },
                "image": {
                    "description": "The digest-pinned container; required when the port runs as a Job.",
                    "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "kind": {
                    "$ref": "#/$defs/PortKind",
                    "description": "in, out or effect."
                },
                "losses": {
                    "description": "What the mapping loses, one entry per lost part; empty only when nothing is lost. An entry is a Loss of contracts/connector.yaml (M01), the format a connector's published loss list uses.",
                    "items": {
                        "$ref": "#/$defs/Loss"
                    },
                    "type": "array"
                },
                "mapping_owner": {
                    "description": "Who answers for the mapping between Rede's kinds and the outside: a role or a team, never a person's account.",
                    "pattern": "^\\S+$",
                    "type": "string"
                },
                "name": {
                    "description": "Port identity in the catalogue.",
                    "pattern": "^[a-z][a-z0-9]*([-_][a-z0-9]+)*$",
                    "type": "string"
                },
                "produces": {
                    "description": "The kinds written: observations, projections, or the results of an effect.",
                    "items": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "requires": {
                    "description": "Pack requirements checked before a run.",
                    "items": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "row_source": {
                    "$ref": "#/$defs/PortRowSource",
                    "description": "How each written row names its source; fixed by the kind."
                },
                "runs_on": {
                    "$ref": "#/$defs/PortInput",
                    "description": "What each run starts from; fixed by the kind."
                },
                "runtime": {
                    "$ref": "#/$defs/PortRuntime",
                    "description": "Where the port runs."
                },
                "secrets": {
                    "description": "Names of secret references the port resolves; never values.",
                    "items": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "version": {
                    "description": "The declared implementation version.",
                    "pattern": "^\\S+$",
                    "type": "string"
                },
                "writes": {
                    "$ref": "#/$defs/PortOutput",
                    "description": "What each run writes; fixed by the kind."
                }
            },
            "required": [
                "name",
                "version",
                "kind",
                "runs_on",
                "writes",
                "row_source",
                "runtime",
                "consumes",
                "produces",
                "freshness",
                "mapping_owner",
                "losses"
            ],
            "title": "Port",
            "type": "object"
        },
        "PortConnector": {
            "additionalProperties": false,
            "description": "The external standard a connector port maps to, and the fixture its mapping round-trips on.",
            "properties": {
                "round_trip": {
                    "description": "The fixture the mapping is tested on: out and back with only the declared losses.",
                    "pattern": "^\\S+$",
                    "type": "string"
                },
                "standard": {
                    "description": "The standard, for example ODCS, DCAT, SHACL, DTDL, Iceberg or OCI.",
                    "pattern": "^\\S+$",
                    "type": "string"
                },
                "standard_version": {
                    "description": "The version of the standard.",
                    "pattern": "^\\S+$",
                    "type": "string"
                }
            },
            "required": [
                "standard",
                "standard_version",
                "round_trip"
            ],
            "title": "PortConnector",
            "type": "object"
        },
        "PortEffect": {
            "additionalProperties": false,
            "description": "The three operations of an effect (A02, A03).",
            "properties": {
                "apply": {
                    "description": "Applies the approved plan once, through the effect journal.",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                    "type": "string"
                },
                "plan": {
                    "description": "Produces the dry-run difference and the plan hash; changes nothing.",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                    "type": "string"
                },
                "status": {
                    "description": "Reconciles the attempt by the plan-hash tag; changes nothing.",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                    "type": "string"
                }
            },
            "required": [
                "plan",
                "apply",
                "status"
            ],
            "title": "PortEffect",
            "type": "object"
        },
        "PortFootprint": {
            "additionalProperties": false,
            "description": "What an in-port makes in its source to be able to read it, such as a probe (ruling of 12-11-2026 on O12a). Allowed only when the source itself was made by an approved effect plan of Rede: every resource the port makes carries that plan's hash under `plan_label`, the port removes it in the same run, and what it could not remove is reported by the run, which then fails (PC11). The approval is that plan's, so the footprint needs no journal row of its own. A port that makes something in a source no approved plan of Rede made, or that leaves something behind on purpose, is a port of kind effect.",
            "properties": {
                "makes": {
                    "description": "The kinds of resource the port makes in its source; each is removed in the same run.",
                    "items": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "plan_label": {
                    "description": "The label or tag every such resource carries; its value is the hash of the approved effect plan that made the source.",
                    "pattern": "^\\S+$",
                    "type": "string"
                }
            },
            "required": [
                "makes",
                "plan_label"
            ],
            "title": "PortFootprint",
            "type": "object"
        },
        "PortFreshness": {
            "additionalProperties": false,
            "description": "The freshness facts of a port (O11): the desired cadence and the largest delay. Rows carry their own observed time and knowledge time; rules may read those, never the cadence.",
            "properties": {
                "cadence": {
                    "$ref": "#/$defs/Cadence",
                    "description": "How often the port should read or write: live, hourly, daily or on request."
                },
                "max_delay_seconds": {
                    "description": "The largest delay between a change and its row, when bounded.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "cadence"
            ],
            "title": "PortFreshness",
            "type": "object"
        },
        "PortInput": {
            "description": "What a run of the port starts from. Each kind has exactly one.",
            "enum": [
                "source",
                "checked_epoch",
                "approved_plan"
            ],
            "title": "PortInput",
            "type": "string"
        },
        "PortInvocation": {
            "additionalProperties": false,
            "description": "One call of a declared port. The input hash is required for every kind and, with the port, its image, the operation and the unit, identifies the attempt. For an in-port it covers the source and position read; for an out-port the checked epoch read; for an effect's plan the canonical export, and for its apply and status the plan hash of the EffectPlan (contracts/effect.yaml). This record describes an attempt and guarantees nothing at runtime; the effect journal claims an attempt durably.",
            "properties": {
                "image": {
                    "description": "The digest-pinned image that ran; absent for a port that runs in-process.",
                    "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "input_sha256": {
                    "description": "The hash of the call's input.",
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                },
                "kind": {
                    "$ref": "#/$defs/PortKind",
                    "description": "The kind of the declared Port."
                },
                "operation": {
                    "description": "The operation called: read (in), write (out), or the effect's plan, apply or status name.",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                    "type": "string"
                },
                "port": {
                    "description": "The name of the declared Port.",
                    "pattern": "^[a-z][a-z0-9]*([-_][a-z0-9]+)*$",
                    "type": "string"
                },
                "unit": {
                    "description": "What the call is about: the source for in, the epoch and role for out, the effect unit for effect.",
                    "type": "string"
                }
            },
            "required": [
                "port",
                "kind",
                "operation",
                "unit",
                "input_sha256"
            ],
            "title": "PortInvocation",
            "type": "object"
        },
        "PortKind": {
            "description": "What a port does at the boundary (O12a).",
            "enum": [
                "in",
                "out",
                "effect"
            ],
            "title": "PortKind",
            "type": "string"
        },
        "PortOutput": {
            "description": "What a port writes. There is no value for curated facts: no port writes them. A curated fact changes only through a proposal that a person or a gate accepts.",
            "enum": [
                "observation",
                "projection",
                "world"
            ],
            "title": "PortOutput",
            "type": "string"
        },
        "PortRowSource": {
            "description": "How each row a port writes names where it comes from (\"a source per row\").",
            "enum": [
                "source",
                "output_index",
                "journal"
            ],
            "title": "PortRowSource",
            "type": "string"
        },
        "PortRuntime": {
            "description": "Where the port runs.",
            "enum": [
                "in_process",
                "job"
            ],
            "title": "PortRuntime",
            "type": "string"
        }
    },
    "$id": "https://rede.dev/contracts/port",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "in"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "not": {
                    "required": [
                        "effect"
                    ]
                },
                "properties": {
                    "effect": {},
                    "row_source": {
                        "const": "source"
                    },
                    "runs_on": {
                        "const": "source"
                    },
                    "writes": {
                        "const": "observation"
                    }
                },
                "required": [
                    "runs_on",
                    "writes",
                    "row_source"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "out"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "not": {
                    "required": [
                        "effect"
                    ]
                },
                "properties": {
                    "effect": {},
                    "row_source": {
                        "const": "output_index"
                    },
                    "runs_on": {
                        "const": "checked_epoch"
                    },
                    "writes": {
                        "const": "projection"
                    }
                },
                "required": [
                    "runs_on",
                    "writes",
                    "row_source"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "effect"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "properties": {
                    "effect": {},
                    "row_source": {
                        "const": "journal"
                    },
                    "runs_on": {
                        "const": "approved_plan"
                    },
                    "writes": {
                        "const": "world"
                    }
                },
                "required": [
                    "runs_on",
                    "writes",
                    "row_source",
                    "effect"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "out"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "not": {
                    "required": [
                        "footprint"
                    ]
                },
                "properties": {
                    "footprint": {}
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "effect"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "not": {
                    "required": [
                        "footprint"
                    ]
                },
                "properties": {
                    "footprint": {}
                }
            }
        },
        {
            "if": {
                "properties": {
                    "runtime": {
                        "const": "job"
                    }
                },
                "required": [
                    "runtime"
                ]
            },
            "then": {
                "properties": {
                    "image": {}
                },
                "required": [
                    "image"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "runtime": {
                        "const": "in_process"
                    }
                },
                "required": [
                    "runtime"
                ]
            },
            "then": {
                "not": {
                    "required": [
                        "image"
                    ]
                },
                "properties": {
                    "image": {}
                }
            }
        }
    ],
    "description": "The static declaration of a port. The kind fixes what a run starts from, what it writes and how each row names its source; the declaration states all three so a port that would write curated facts, or an out-port that would run on an unchecked epoch, cannot be declared.",
    "metamodel_version": "1.12.0",
    "properties": {
        "connector": {
            "anyOf": [
                {
                    "$ref": "#/$defs/PortConnector"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The external standard, when the port is a connector."
        },
        "consumes": {
            "description": "The kinds read: sources, Output schemas, files or plans.",
            "items": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                "type": "string"
            },
            "minItems": 1,
            "type": "array"
